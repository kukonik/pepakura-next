{
    "custom": {
      "api_endpoint": "http://127.0.0.1:7860/v1/completions",
      "model": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
      "headers": {
        "Content-Type": "application/json"
      },
      "request_template": {
        "model": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
        "prompt": "Ты опытный разработчик на Rust, помогающий с проектом Pepakura Next...\n\n{{prompt}}",
        "max_tokens": 2048,
        "temperature": 0.7,
        "top_p": 0.95,
        "stop": ["</s>"]
      }
    }
  }