{
  "build": {
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "pepakura-next",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "identifier": "com.pepakura-next.app",
      "icon": [],
      "resources": []
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "title": "Pepakura Next",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
