<template>
  <div class="viewer-container" ref="containerRef">
    <div v-if="error" class="error-overlay">{{ error }}</div>
    <div v-if="isLoading" class="loading-overlay">Парсинг OBJ...</div>
  </div>
</template>

<script setup lang="ts">
import { ref, watch, onMounted, onUnmounted } from 'vue';
import * as THREE from 'three';
import { OBJLoader } from 'three/examples/jsm/loaders/OBJLoader.js';
import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

// FIX41: фолбэк на первую доступную текстуру + лог [TEX41] + кадр после загрузки текстуры
const props = defineProps<{ meshData: string; mtlData?: string | null; textureMap?: Record<string, string> }>();
const containerRef = ref<HTMLDivElement | null>(null);
const error = ref('');
const isLoading = ref(false);

let scene: THREE.Scene, camera: THREE.PerspectiveCamera, renderer: THREE.WebGLRenderer, controls: OrbitControls;
let currentModel: THREE.Group | null = null;
let renderScene: () => void = () => {};

const sanitizeObj = (text: string) => text.replace(/^V /gm, 'v ').replace(/^F /gm, 'f ');

const disposeMaterial = (m: any) => {
  if (!m) return;
  if (m.map) m.map.dispose();
  m.dispose();
};

const applyMaterials = (obj: THREE.Group) => {
  const texLoader = new THREE.TextureLoader();
  const maxAniso = renderer && renderer.capabilities ? renderer.capabilities.getMaxAnisotropy() : 1;
  const keys = Object.keys(props.textureMap || {});
  const seen: string[] = [];
  let withTex = 0;
  obj.traverse((child) => {
    if (!(child as THREE.Mesh).isMesh) return;
    const mesh = child as THREE.Mesh;
    const rawMat: any = Array.isArray(mesh.material) ? mesh.material[0] : mesh.material;
    const matName = rawMat && rawMat.name ? String(rawMat.name) : '';
    if (seen.indexOf(matName) === -1) seen.push(matName);
    let dataUrl = (props.textureMap && matName) ? props.textureMap[matName] : undefined;
    if (!dataUrl && keys.length > 0) dataUrl = (props.textureMap as Record<string, string>)[keys[0]]; // FIX41: фолбэк
    disposeMaterial(rawMat);
    if (dataUrl) {
      withTex++;
      const tex = texLoader.load(dataUrl, () => { renderScene(); }); // FIX41: кадр после загрузки
      if ((THREE as any).SRGBColorSpace !== undefined) { (tex as any).colorSpace = (THREE as any).SRGBColorSpace; }
      else if ((THREE as any).sRGBEncoding !== undefined) { (tex as any).encoding = (THREE as any).sRGBEncoding; }
      tex.anisotropy = maxAniso;
      mesh.material = new THREE.MeshStandardMaterial({ map: tex, roughness: 0.9, metalness: 0.0 });
    } else {
      mesh.material = new THREE.MeshStandardMaterial({ color: 0x007acc });
    }
  });
  console.log('[TEX41] mats=[' + seen.join(' | ') + '] texKeys=[' + keys.join(' | ') + '] withTex=' + withTex); // FIX41
};

onMounted(() => {
  if (!containerRef.value) return;
  scene = new THREE.Scene(); scene.background = new THREE.Color(0x1e1e1e);
  camera = new THREE.PerspectiveCamera(45, containerRef.value.clientWidth / containerRef.value.clientHeight, 0.1, 1000);
  camera.position.set(0, 1.5, 5);
  renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
  renderer.setSize(containerRef.value.clientWidth, containerRef.value.clientHeight);
  containerRef.value.appendChild(renderer.domElement);
  controls = new OrbitControls(camera, renderer.domElement);
  scene.add(new THREE.AmbientLight(0xffffff, 0.6));
  const dir = new THREE.DirectionalLight(0xffffff, 0.8); dir.position.set(3, 5, 4); scene.add(dir);
  scene.add(new THREE.GridHelper(10, 20, 0x3a3a3a, 0x2c2c2c));
  scene.add(new THREE.AxesHelper(2));

  renderScene = () => { renderer.render(scene, camera); };
  controls.addEventListener('change', renderScene);

  const onResize = () => {
    if (!containerRef.value || !renderer) return;
    const w = containerRef.value.clientWidth;
    const h = containerRef.value.clientHeight;
    if (w === 0 || h === 0) return;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
    renderScene();
  };
  window.addEventListener('resize', onResize);
  (containerRef.value as any).__fix40onResize = onResize;
  renderScene();
});

watch(() => props.meshData, (newData) => {
  if (!renderer || !newData) return;
  isLoading.value = true; error.value = '';
  if (currentModel) {
    scene.remove(currentModel);
    currentModel.traverse((child) => { const mesh = child as THREE.Mesh; if (mesh.isMesh) { mesh.geometry.dispose(); if (Array.isArray(mesh.material)) mesh.material.forEach(disposeMaterial); else disposeMaterial(mesh.material as any); } });
    currentModel = null;
  }
  try {
    const sanitized = sanitizeObj(newData);
    const obj = new OBJLoader().parse(sanitized);
    applyMaterials(obj);
    currentModel = obj; scene.add(currentModel);
    const box = new THREE.Box3().setFromObject(currentModel); const center = box.getCenter(new THREE.Vector3()); const size = box.getSize(new THREE.Vector3());
    currentModel.position.sub(center); currentModel.scale.multiplyScalar(3 / Math.max(size.x, size.y, size.z));
    renderScene();
  } catch (e: any) { error.value = 'Ошибка формата OBJ: ' + e.message; } finally { isLoading.value = false; }
}, { flush: 'post' });

watch(() => props.textureMap, () => {
  if (currentModel) { applyMaterials(currentModel); renderScene(); }
}, { deep: true });

onUnmounted(() => {
  const c: any = containerRef.value;
  if (c && c.__fix40onResize) { window.removeEventListener('resize', c.__fix40onResize); }
  if (controls) controls.removeEventListener('change', renderScene);
  if (renderer) renderer.dispose();
});
</script>

<style scoped>
.viewer-container { width: 100%; height: 100%; position: relative; background: #1e1e1e; }
.error-overlay { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: red; background: rgba(0,0,0,0.8); padding: 10px; }
.loading-overlay { position: absolute; top: 10px; left: 10px; color: #fff; font-family: monospace; }
</style>