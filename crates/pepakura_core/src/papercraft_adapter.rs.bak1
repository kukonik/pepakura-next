// [MEM48-B] papercraft_adapter - точка входа papercraft-развёртки для Tauri.
// Временная реализация ради зелёной сборки: реальный порт papercraft v2.12
// (paper/craft.rs, MST + раскладка по полкам) подключается отдельным блоком.
use serde::{Deserialize, Serialize};

use crate::geometry::Mesh;
use crate::unwrap_types::UnwrapMetrics;

#[derive(Debug, Clone, Default, Serialize, Deserialize)]
pub struct PapercraftPiece {
    pub id: u32,
    pub face_ids: Vec<u32>,
    pub outline_2d: Vec<[f64; 2]>,
    pub fold_lines: Vec<[[f64; 2]; 2]>,
    pub cut_lines: Vec<[[f64; 2]; 2]>,
}

#[derive(Debug, Clone, Default, Serialize, Deserialize)]
pub struct PapercraftUnfoldResult {
    pub pieces: Vec<PapercraftPiece>,
    pub metrics: UnwrapMetrics,
}

pub fn unfold_with_papercraft(mesh: &Mesh) -> Result<PapercraftUnfoldResult, String> {
    if mesh.vertices.is_empty() || mesh.faces.is_empty() {
        return Err("[MEM48-B] пустой меш: нет вершин или граней".to_string());
    }
    let metrics = UnwrapMetrics {
        total_pieces: mesh.faces.len() as u32,
        total_pages: 0,
        total_folds: 0,
        total_tabs: 0,
        complexity_score: 0.0,
    };
    Ok(PapercraftUnfoldResult { pieces: Vec::new(), metrics })
}