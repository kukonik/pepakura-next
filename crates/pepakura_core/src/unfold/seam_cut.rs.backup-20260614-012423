//! Умное разрезание меша на основе жёстких рёбер (Sharp Edges)
//! Алгоритм: ищем ребра с углом > порога -> помечаем как шов -> flood-fill оставшихся граней -> острова

use crate::geometry::{Mesh, Face, Vertex};
use std::collections::HashMap;

fn face_normal(face: &Face, vertices: &[Vertex]) -> [f64; 3] {
    let v0 = vertices[face.vertices[0]].position;
    let v1 = vertices[face.vertices[1]].position;
    let v2 = vertices[face.vertices[2]].position;
    
    let a = [v1[0] - v0[0], v1[1] - v0[1], v1[2] - v0[2]];
    let b = [v2[0] - v0[0], v2[1] - v0[1], v2[2] - v0[2]];
    
    let cross = [
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0],
    ];
    
    let len = (cross[0]*cross[0] + cross[1]*cross[1] + cross[2]*cross[2]).sqrt();
    if len > 1e-10 { [cross[0]/len, cross[1]/len, cross[2]/len] } else { [0.0, 0.0, 0.0] }
}

fn dot(a: &[f64; 3], b: &[f64; 3]) -> f64 {
    a[0]*b[0] + a[1]*b[1] + a[2]*b[2]
}

/// Разрезает меш на острова по жёстким ребрам.
/// Возвращает вектор островов, где каждый остров — это вектор индексов граней.
pub fn cut_by_sharp_edges(mesh: &Mesh, angle_threshold_deg: f64) -> Vec<Vec<usize>> {
    let mut edge_faces: HashMap<(usize, usize), Vec<usize>> = HashMap::new();
    
    // 1. Собираем гранули смежности для каждого ребра
    for (fi, face) in mesh.faces.iter().enumerate() {
        for i in 0..3 {
            let v0 = face.vertices[i];
            let v1 = face.vertices[(i + 1) % 3];
            let edge = if v0 < v1 { (v0, v1) } else { (v1, v0) };
            edge_faces.entry(edge).or_default().push(fi);
        }
    }
    
    let mut is_seam = HashMap::new();
    
    // 2. Определяем швы по двугранному углу
    for (edge, faces) in &edge_faces {
        if faces.len() == 2 {
            let n1 = face_normal(&mesh.faces[faces[0]], &mesh.vertices);
            let n2 = face_normal(&mesh.faces[faces[1]], &mesh.vertices);
            let cos_theta = dot(&n1, &n2).clamp(-1.0, 1.0);
            let angle = cos_theta.acos().to_degrees();
            
            // Если угол острый (сгиб бумаги) - это шов
            if angle > angle_threshold_deg {
                is_seam.insert(edge, true);
            }
        } else {
            // Граница меша - тоже шов
            is_seam.insert(edge, true);
        }
    }
    
    // 3. Flood-fill для группировки островов
    let mut visited = vec![false; mesh.faces.len()];
    let mut islands = Vec::new();
    
    for start_fi in 0..mesh.faces.len() {
        if visited[start_fi] { continue; }
        
        let mut island = Vec::new();
        let mut stack = vec![start_fi];
        
        while let Some(fi) = stack.pop() {
            if visited[fi] { continue; }
            visited[fi] = true;
            island.push(fi);
            
            let face = &mesh.faces[fi];
            for i in 0..3 {
                let v0 = face.vertices[i];
                let v1 = face.vertices[(i + 1) % 3];
                let edge = if v0 < v1 { (v0, v1) } else { (v1, v0) };
                
                // Переходим на соседнюю грань, только если это НЕ шов
                if !is_seam.contains_key(&edge) {
                    if let Some(adj_faces) = edge_faces.get(&edge) {
                        for &adj_fi in adj_faces {
                            if !visited[adj_fi] { stack.push(adj_fi); }
                        }
                    }
                }
            }
        }
        islands.push(island);
    }
    
    islands
}
