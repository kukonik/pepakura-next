// ---------- [EXP51] служебные ----------

const MARGIN_MM: f64 = 10.0;
const GAP_MM: f64 = 3.0;
const MM2PT: f64 = 72.0 / 25.4;

fn page_size_mm(ps: &PageSize, o: &PdfOrientation) -> (f64, f64) {
    let (w, h) = match ps {
        PageSize::A4 => (210.0, 297.0),
        PageSize::A3 => (297.0, 420.0),
        PageSize::A2 => (420.0, 594.0),
        PageSize::A1 => (594.0, 841.0),
        PageSize::Letter => (215.9, 279.4),
    };
    match o {
        PdfOrientation::Portrait => (w, h),
        PdfOrientation::Landscape => (h, w),
    }
}

fn fnum(v: &serde_json::Value) -> f64 { v.as_f64().unwrap_or(0.0) }

fn collect_indices(v: &serde_json::Value) -> Vec<usize> {
    if let Some(a) = v.as_array() {
        a.iter().filter_map(|x| x.as_u64()).map(|x| x as usize).collect()
    } else {
        Vec::new()
    }
}

fn uf_find(parent: &mut Vec<usize>, mut x: usize) -> usize {
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

/// Tolerant-парсинг payload: vertices_2d [[x,y]..], faces [[i,..]..] или [{"vertices":[i,..]}],
/// island_ids (опционально). Если vertices_2d нет на верхнем уровне -
/// ищем на глубине 1 (например, внутри обёртки проекта).
fn parse_payload<T: serde::Serialize>(result: &T) -> Result<(Vec<[f64; 2]>, Vec<Vec<usize>>, Vec<usize>), String> {
    let v = serde_json::to_value(result).map_err(|e| format!("[EXP51] не удалось сериализовать payload: {}", e))?;
    let mut node: &serde_json::Value = &v;
    if node.get("vertices_2d").is_none() {
        if let Some(obj) = v.as_object() {
            for (_k, val) in obj {
                if val.get("vertices_2d").is_some() { node = val; break; }
            }
        }
    }
    let varr = node.get("vertices_2d").and_then(|x| x.as_array())
        .ok_or("[EXP51] в payload нет vertices_2d (ожидается [[x,y],..])")?;
    let mut verts: Vec<[f64; 2]> = Vec::with_capacity(varr.len());
    for p in varr {
        let pa = p.as_array().ok_or("[EXP51] вершина не является массивом [x,y]")?;
        if pa.len() < 2 { return Err("[EXP51] у вершины меньше 2 координат".into()); }
        verts.push([fnum(&pa[0]), fnum(&pa[1])]);
    }
    let mut faces: Vec<Vec<usize>> = Vec::new();
    if let Some(fs) = node.get("faces").and_then(|x| x.as_array()) {
        for f in fs {
            let ids: Vec<usize> = match f {
                serde_json::Value::Array(_) => collect_indices(f),
                serde_json::Value::Object(o) => o.get("vertices").map(collect_indices).unwrap_or_default(),
                _ => Vec::new(),
            };
            if ids.len() >= 3 { faces.push(ids); }
        }
    }
    let islands: Vec<usize> = node.get("island_ids").and_then(|x| x.as_array())
        .map(|a| a.iter().filter_map(|x| x.as_u64()).map(|x| x as usize).collect())
        .unwrap_or_default();
    Ok((verts, faces, islands))
}

struct PlacedIsland { page: usize, off: [f64; 2], faces_idx: Vec<usize>, w: f64, h: f64 }

// ---------- [EXP51] PDF ----------

pub fn export_pdf<T: serde::Serialize>(result: &T, config: &PdfExportConfig) -> Result<Vec<u8>, String> {
    let (pw_mm, ph_mm) = page_size_mm(&config.page_size, &config.orientation);
    let (pw, ph) = (pw_mm * MM2PT, ph_mm * MM2PT);
    let margin = MARGIN_MM * MM2PT;
    let gap = GAP_MM * MM2PT;

    let (verts, faces, _islands) = parse_payload(result)?;
    if verts.is_empty() { return Err("[EXP51] vertices_2d пуст".into()); }
    if faces.is_empty() { return Err("[EXP51] faces пуст (нет граней из 3+ вершин)".into()); }

    // 1) полигоны в пунктах при базовом масштабе (scale = мм на единицу модели)
    let scale0 = if config.scale > 0.0 { config.scale } else { 1.0 };
    let mut locals: Vec<Vec<[f64; 2]>> = Vec::with_capacity(faces.len());
    for f in &faces {
        let mut poly: Vec<[f64; 2]> = Vec::with_capacity(f.len());
        let mut ok = true;
        for &i in f {
            if i >= verts.len() { ok = false; break; }
            poly.push([verts[i][0] * scale0 * MM2PT, verts[i][1] * scale0 * MM2PT]);
        }
        if !ok { poly.clear(); }
        locals.push(poly);
    }

    // 2) острова: грани, соединённые сгибами (ребро у 2+ граней), держим вместе (union-find)
    let mut parent: Vec<usize> = (0..faces.len()).collect();
    let mut efaces: HashMap<(usize, usize), Vec<usize>> = HashMap::new();
    for (fi, f) in faces.iter().enumerate() {
        if f.len() < 3 || locals[fi].is_empty() { continue; }
        for i in 0..f.len() {
            let (a, b) = (f[i], f[(i + 1) % f.len()]);
            if a >= verts.len() || b >= verts.len() { continue; }
            let k = if a < b { (a, b) } else { (b, a) };
            efaces.entry(k).or_default().push(fi);
        }
    }
    for (_k, fs) in &efaces {
        if fs.len() >= 2 {
            for i in 1..fs.len() {
                let ra = uf_find(&mut parent, fs[0]);
                let rb = uf_find(&mut parent, fs[i]);
                if ra != rb { parent[ra] = rb; }
            }
        }
    }
    let mut groups: HashMap<usize, Vec<usize>> = HashMap::new();
    for fi in 0..faces.len() {
        if !locals[fi].is_empty() {
            let r = uf_find(&mut parent, fi);
            groups.entry(r).or_default().push(fi);
        }
    }
    let mut island_list: Vec<Vec<usize>> = groups.into_values().collect();
    island_list.sort_by_key(|g| g[0]);
    println!("[EXP51] островов={} (граней {})", island_list.len(), faces.len());

    // 3) авто-вписывание, если самый крупный остров не помещается на страницу
    let uw = pw - 2.0 * margin;
    let uh = ph - 2.0 * margin;
    let (mut max_w, mut max_h) = (0.0f64, 0.0f64);
    for g in &island_list {
        let (mut mnx, mut mny, mut mxx, mut mxy) = (f64::MAX, f64::MAX, f64::MIN, f64::MIN);
        for &fi in g {
            for p in &locals[fi] {
                if p[0] < mnx { mnx = p[0]; }
                if p[0] > mxx { mxx = p[0]; }
                if p[1] < mny { mny = p[1]; }
                if p[1] > mxy { mxy = p[1]; }
            }
        }
        if mxx - mnx > max_w { max_w = mxx - mnx; }
        if mxy - mny > max_h { max_h = mxy - mny; }
    }
    if max_w > uw || max_h > uh {
        let k = (uw / max_w).min(uh / max_h).min(1.0);
        println!("[EXP51] auto-fit x{:.4}: деталь {:.1}x{:.1} мм больше полей страницы {:.1}x{:.1} мм", k, max_w / MM2PT, max_h / MM2PT, uw / MM2PT, uh / MM2PT);
        for poly in locals.iter_mut() {
            for p in poly.iter_mut() { p[0] *= k; p[1] *= k; }
        }
    }

    // 4) нормализация каждого острова к (0,0) и подготовка к упаковке
    let mut items: Vec<(usize, f64, f64)> = Vec::new(); // (island_idx, w, h) в pt
    for (ii, g) in island_list.iter().enumerate() {
        let (mut mnx, mut mny, mut mxx, mut mxy) = (f64::MAX, f64::MAX, f64::MIN, f64::MIN);
        for &fi in g {
            for p in &locals[fi] {
                if p[0] < mnx { mnx = p[0]; }
                if p[0] > mxx { mxx = p[0]; }
                if p[1] < mny { mny = p[1]; }
                if p[1] > mxy { mxy = p[1]; }
            }
        }
        for &fi in g {
            for p in locals[fi].iter_mut() { p[0] -= mnx; p[1] -= mny; }
        }
        items.push((ii, mxx - mnx, mxy - mny));
    }
    items.sort_by(|a, b| b.2.partial_cmp(&a.2).unwrap_or(std::cmp::Ordering::Equal));

    // 5) упаковка островов "полками" по страницам (высокие первыми)
    let mut placed: Vec<PlacedIsland> = Vec::new();
    let (mut page_i, mut cur_x, mut cur_y, mut row_h) = (0usize, margin, margin, 0.0f64);
    for &(ii, w, h) in &items {
        if cur_x + w > pw - margin {
            cur_x = margin;
            cur_y += row_h + gap;
            row_h = 0.0;
        }
        if cur_y + h > ph - margin {
            page_i += 1;
            cur_x = margin;
            cur_y = margin;
            row_h = 0.0;
        }
        placed.push(PlacedIsland { page: page_i, off: [cur_x, cur_y], faces_idx: island_list[ii].clone(), w, h });
        cur_x += w + gap;
        if h > row_h { row_h = h; }
    }
    let page_count = page_i + 1;

    // 6) классификация рёбер по числу смежных граней: 1 -> рез, 2+ -> сгиб
    let mut ecount: HashMap<(usize, usize), u32> = HashMap::new();
    for f in &faces {
        if f.len() < 3 { continue; }
        for i in 0..f.len() {
            let (a, b) = (f[i], f[(i + 1) % f.len()]);
            if a >= verts.len() || b >= verts.len() { continue; }
            let k = if a < b { (a, b) } else { (b, a) };
            *ecount.entry(k).or_insert(0) += 1;
        }
    }

    // 7) содержимое страниц (координаты в pt, начало - левый нижний угол)
    let mut contents: Vec<String> = vec![String::new(); page_count];

    if config.show_grid {
        let gs = if config.grid_size_mm > 0.0 { config.grid_size_mm * MM2PT } else { 10.0 * MM2PT };
        let mut x = margin;
        while x <= pw - margin + 0.01 {
            for p in 0..page_count {
                contents[p].push_str(&format!("0.87 0.87 0.87 RG 0.25 w {:.2} {:.2} m {:.2} {:.2} l S\n", x, margin, x, ph - margin));
            }
            x += gs;
        }
        let mut y = margin;
        while y <= ph - margin + 0.01 {
            for p in 0..page_count {
                contents[p].push_str(&format!("0.87 0.87 0.87 RG 0.25 w {:.2} {:.2} m {:.2} {:.2} l S\n", margin, y, pw - margin, y));
            }
            y += gs;
        }
    }

    // заливка граней светло-серым
    for pl in &placed {
        for &fi in &pl.faces_idx {
            let poly = &locals[fi];
            if poly.len() < 3 { continue; }
            let mut s = String::from("0.96 0.96 0.96 rg\n");
            for (i, p) in poly.iter().enumerate() {
                let px = pl.off[0] + p[0];
                let py = ph - (pl.off[1] + p[1]);
                let op = if i == 0 { "m" } else { "l" };
                s.push_str(&format!("{:.2} {:.2} {} \n", px, py, op));
            }
            s.push_str("h f\n");
            contents[pl.page].push_str(&s);
        }
    }

    // рез (красный сплошной) и сгибы (чёрный пунктир)
    let mut fold_drawn: HashSet<(usize, usize)> = HashSet::new();
    let (mut cut_cnt, mut fold_cnt) = (0usize, 0usize);
    for pl in &placed {
        for &fi in &pl.faces_idx {
            let f = &faces[fi];
            let poly = &locals[fi];
            let n = poly.len();
            if n < 3 { continue; }
            let mut cut_edges: Vec<[[f64; 2]; 2]> = Vec::new();
            let mut fold_edges: Vec<[[f64; 2]; 2]> = Vec::new();
            for i in 0..n {
                let (a, b) = (f[i], f[(i + 1) % n]);
                let p1 = [pl.off[0] + poly[i][0], ph - (pl.off[1] + poly[i][1])];
                let p2 = [pl.off[0] + poly[(i + 1) % n][0], ph - (pl.off[1] + poly[(i + 1) % n][1])];
                if a >= verts.len() || b >= verts.len() { cut_edges.push([p1, p2]); continue; }
                let k = if a < b { (a, b) } else { (b, a) };
                let cnt = *ecount.get(&k).unwrap_or(&1);
                if cnt >= 2 {
                    if fold_drawn.insert(k) { fold_edges.push([p1, p2]); }
                } else {
                    cut_edges.push([p1, p2]);
                }
            }
            if config.show_cut_lines && !cut_edges.is_empty() {
                let mut s = String::from("1 0 0 RG 0.75 w [] 0 d\n");
                for e in &cut_edges {
                    s.push_str(&format!("{:.2} {:.2} m {:.2} {:.2} l S\n", e[0][0], e[0][1], e[1][0], e[1][1]));
                }
                contents[pl.page].push_str(&s);
                cut_cnt += cut_edges.len();
            }
            if config.show_fold_lines && !fold_edges.is_empty() {
                let mut s = String::from("0 0 0 RG 0.6 w [3 2] 0 d\n");
                for e in &fold_edges {
                    s.push_str(&format!("{:.2} {:.2} m {:.2} {:.2} l S\n", e[0][0], e[0][1], e[1][0], e[1][1]));
                }
                contents[pl.page].push_str(&s);
                fold_cnt += fold_edges.len();
            }
        }
    }

    // номера деталей: одна подпись на остров на страницу (в центре bbox острова)
    if config.show_part_numbers {
        let mut seen: HashSet<(usize, usize)> = HashSet::new();
        for (idx, pl) in placed.iter().enumerate() {
            if !seen.insert((pl.page, idx)) { continue; }
            let px = pl.off[0] + pl.w / 2.0;
            let py = ph - (pl.off[1] + pl.h / 2.0);
            contents[pl.page].push_str(&format!("BT /F1 9 Tf 0 0 0 rg {:.2} {:.2} Td (P{}) Tj ET\n", px, py, idx + 1));
        }
    }

    // подпись страницы (как в papercraft: "Page i/N")
    for (p, c) in contents.iter_mut().enumerate() {
        let t = format!("Page {}/{}", p + 1, page_count);
        let tw = t.len() as f64 * 4.5;
        c.push_str(&format!("BT /F1 8 Tf 0.45 0.45 0.45 rg {:.2} 14.00 Td ({}) Tj ET\n", pw - margin - tw, t));
    }

    println!("[EXP51] раскладка: страниц={} островов={} рез-сегментов={} сгибов={}", page_count, placed.len(), cut_cnt, fold_cnt);

    // 8) сборка PDF (std-only)
    let n = page_count;
    let mut objs: Vec<(bool, Vec<u8>)> = Vec::with_capacity(4 + 2 * n);
    objs.push((false, b"<< /Type /Catalog /Pages 2 0 R >>".to_vec()));
    let mut kids = String::new();
    for i in 0..n { kids.push_str(&format!("{} 0 R ", 5 + 2 * i)); }
    objs.push((false, format!("<< /Type /Pages /Kids [{}] /Count {} /MediaBox [0 0 {:.2} {:.2}] >>", kids.trim_end(), n, pw, ph).into_bytes()));
    objs.push((false, b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>".to_vec()));
    for i in 0..n {
        let content_num = 4 + 2 * i;
        objs.push((true, contents[i].as_bytes().to_vec()));
        objs.push((false, format!("<< /Type /Page /Parent 2 0 R /Contents {} 0 R /Resources << /Font << /F1 3 0 R >> >> >>", content_num).into_bytes()));
    }
    objs.push((false, b"<< /Producer (pepakura-next EXP51) /Title (pepakura-next unfold) >>".to_vec()));

    let mut out: Vec<u8> = Vec::new();
    out.extend_from_slice(b"%PDF-1.4\n%\xE2\xE3\xCF\xD3\n");
    let mut offsets: Vec<usize> = Vec::with_capacity(objs.len());
    for (idx, (is_stream, payload)) in objs.iter().enumerate() {
        offsets.push(out.len());
        out.extend_from_slice(format!("{} 0 obj\n", idx + 1).as_bytes());
        if *is_stream {
            out.extend_from_slice(format!("<< /Length {} >>\nstream\n", payload.len()).as_bytes());
            out.extend_from_slice(payload);
            out.extend_from_slice(b"\nendstream\n");
        } else {
            out.extend_from_slice(payload);
            out.extend_from_slice(b"\n");
        }
        out.extend_from_slice(b"endobj\n");
    }
    let xref_pos = out.len();
    let total = objs.len() + 1;
    let info_id = objs.len();
    out.extend_from_slice(format!("xref\n0 {}\n", total).as_bytes());
    out.extend_from_slice(b"0000000000 65535 f \n");
    for off in &offsets {
        out.extend_from_slice(format!("{:010} 00000 n \n", off).as_bytes());
    }
    out.extend_from_slice(
        format!("trailer\n<< /Size {} /Root 1 0 R /Info {} 0 R >>\nstartxref\n{}\n%%EOF\n", total, info_id, xref_pos).as_bytes(),
    );

    println!("[EXP51] pdf собран: {} байт, объектов={}", out.len(), objs.len());
    Ok(out)
}

pub fn export_pdf_to_file<T: serde::Serialize>(result: &T, config: &PdfExportConfig, path: &str) -> Result<(), String> {
    let bytes = export_pdf(result, config)?;
    std::fs::write(path, &bytes).map_err(|e| format!("[EXP51] не удалось записать {}: {}", path, e))?;
    let meta = std::fs::metadata(path).map_err(|e| format!("[EXP51] metadata {}: {}", path, e))?;
    println!("[EXP51] файл записан: {} (на диске {} байт, ожидалось {})", path, meta.len(), bytes.len());
    if meta.len() as usize != bytes.len() {
        return Err(format!("[EXP51] размер файла {} != ожидаемых {} байт", meta.len(), bytes.len()));
    }
    if !bytes.starts_with(b"%PDF") {
        return Err("[EXP51] буфер не начинается с %PDF".into());
    }
    println!("[EXP51] OK: %PDF-заголовок на месте, размер совпадает");
    Ok(())
}