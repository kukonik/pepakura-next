            engine_used: "Papercraft".into(), vertices_2d: vec![], total_area: 0.0, total_perimeter: 0.0,
            pieces: vec![], pages: vec![], metrics: Default::default(), sheet_width: 0.0, sheet_height: 0.0, margin: 0.0,
        })
    }
}

