use crate::Mesh;
use crate::unwrap_types::{UnwrapResult, Page, UnwrapMetrics};

pub fn unfold_with_papercraft(mesh: &Mesh) -> Result<UnwrapResult, String> {
    if mesh.faces.is_empty() {
        return Err("Mesh is empty".to_string());
    }

    // Простая проекция 3D -> 2D (отбрасываем Z)
    let av: Vec<[f64; 2]> = mesh.vertices.iter().map(|v| [v.x as f64, v.y as f64]).collect();

    Ok(UnwrapResult {
        engine_used: "papercraft_projection".to_string(),
        vertices_2d: av,
        faces: mesh.faces.iter().map(|f| f.vertices.clone()).collect(),
        total_area: 0.0,
        total_perimeter: 0.0,
        pieces: vec![], // Фронтенд сам построит pieces из vertices_2d и faces
        pages: vec![Page { page_number: 0, piece_ids: vec![], utilization_percent: 0.0 }],
        metrics: UnwrapMetrics { total_pieces: 0, total_pages: 1, total_folds: 0, total_tabs: 0, complexity_score: 0.0 },
        sheet_width: 1000.0,
        sheet_height: 1000.0,
        margin: 10.0,
    })
}
