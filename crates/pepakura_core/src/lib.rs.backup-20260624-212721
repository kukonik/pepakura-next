// ── unwrap_types ─────────────────────────────────────────
pub mod unwrap_types {
    use serde::{Deserialize, Serialize};

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct Point2D {
        pub x: f32,
        pub y: f32,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct Polygon {
        pub points: Vec<Point2D>,
        pub holes: Vec<Vec<Point2D>>,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct FoldLine {
        pub start: Point2D,
        pub end: Point2D,
        pub fold_type: FoldType,
        pub angle: f32,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub enum FoldType {
        Mountain,
        Valley,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct Tab {
        pub poly: Vec<Point2D>,
        pub glue_to_piece_id: usize,
        pub glue_edge_index: usize,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct Piece {
        pub id: u32,
        pub name: String,
        pub label: Option<String>,
        pub outline: Polygon,
        pub folds: Vec<FoldLine>,
        pub tabs: Vec<Tab>,
        pub area: f32,
        pub perimeter: f32,
        pub page_number: u32,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct Page {
        pub page_number: usize,
        pub piece_ids: Vec<usize>,
        pub utilization_percent: f32,
    }

    #[derive(Debug, Clone, Serialize, Deserialize, Default)]
    pub struct UnwrapMetrics {
        pub total_pieces: u32,
        pub total_pages: u32,
        pub total_folds: u32,
        pub total_tabs: u32,
        pub complexity_score: f32,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct UnwrapResult {
        pub engine_used: String,
        pub pieces: Vec<Piece>,
        pub pages: Vec<Page>,
        pub metrics: UnwrapMetrics,
        pub sheet_width: f32,
        pub sheet_height: f32,
        pub margin: f32,
    }

    // Реэкспорт для совместимости
    pub use super::unfold::UnfoldedMesh;
    pub use super::unfold::UnfoldResult;
}

