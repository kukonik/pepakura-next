// ── Unfold ────────────────────────────────────────────────
pub mod unfold {
    use super::*;

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub enum UnfoldAlgorithm {
        Lscm,
        Mds,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct UnfoldConfig {
        pub algorithm: UnfoldAlgorithm,
        pub margin: f32,
        pub fold_angle_threshold: f32,
    }

    impl Default for UnfoldConfig {
        fn default() -> Self {
            Self {
                algorithm: UnfoldAlgorithm::Lscm,
                margin: 10.0,
                fold_angle_threshold: 5.0,
            }
        }
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct UnfoldedMesh {
        pub vertices_2d: Vec<[f32; 2]>,
        pub faces: Vec<Vec<usize>>,
        pub island_ids: Vec<usize>,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct UnfoldMetadata {
        pub is_degenerate: bool,
        pub area_2d: f32,
    }

    #[derive(Debug, Clone, Serialize, Deserialize)]
    pub struct UnfoldResult {
        pub vertices_2d: Vec<[f32; 2]>,
        pub faces: Vec<Vec<usize>>,
        pub island_ids: Vec<usize>,
        pub metadata: UnfoldMetadata,
        pub sheet_count: u32,
    }

    // Вспомогательная для создания результата
    impl UnfoldResult {
        pub fn empty() -> Self {
            UnfoldResult {
                vertices_2d: vec![],
                faces: vec![],
                island_ids: vec![],
                metadata: UnfoldMetadata { is_degenerate: false, area_2d: 0.0 },
                sheet_count: 1,
            }
        }
    }

    pub fn unfold_lscm(_mesh: &Mesh, _config: &UnfoldConfig) -> UnfoldResult {
        UnfoldResult::empty()
    }

    pub fn unfold_mst(mesh: &Mesh, _config: &UnfoldConfig) -> Result<UnfoldResult, String> {
        if mesh.faces.is_empty() { return Ok(UnfoldResult::empty()); }

        let mut v2d = vec![[0.0f32, 0.0f32]; mesh.vertices.len()];
        let mut visited = vec![false; mesh.faces.len()];
        let mut queue = std::collections::VecDeque::new();

        // 1. Строим карту ребер -> грани
        let mut edge_map: std::collections::HashMap<(usize, usize), Vec<usize>> = std::collections::HashMap::new();
        for (fi, f) in mesh.faces.iter().enumerate() {
            if f.vertices.len() < 3 { continue; }
            for i in 0..3 {
                let v1 = f.vertices[i];
                let v2 = f.vertices[(i + 1) % 3];
                let key = if v1 < v2 { (v1, v2) } else { (v2, v1) };
                edge_map.entry(key).or_default().push(fi);
            }
        }

        // 2. Инициализация корневой грани (проекция на плоскость XY)
        let root_f = &mesh.faces[0];
        if root_f.vertices.len() >= 3 {
            for &vi in &root_f.vertices {
                let v = &mesh.vertices[vi];
                v2d[vi] = [v.x, v.y];
            }
            visited[0] = true;
            queue.push_back(0);
        }

        // 3. BFS развёртывание (Жесткая трансформация по общим ребрам)
        while let Some(fi) = queue.pop_front() {
            let f = &mesh.faces[fi];
            if f.vertices.len() < 3 { continue; }
            
            for i in 0..3 {
                let v1 = f.vertices[i];
                let v2 = f.vertices[(i + 1) % 3];
                let key = if v1 < v2 { (v1, v2) } else { (v2, v1) };
                
                if let Some(adj_faces) = edge_map.get(&key) {
                    for &nfi in adj_faces {
                        if visited[nfi] { continue; }
                        visited[nfi] = true;
                        let nf = &mesh.faces[nfi];
                        
                        // Находим 3-ю вершину соседней грани (которая не на общем ребре)
                        let mut v3_3d = [0.0f32, 0.0f32, 0.0f32];
                        for &vi in &nf.vertices {
                            if vi != v1 && vi != v2 { v3_3d = [mesh.vertices[vi].x, mesh.vertices[vi].y, mesh.vertices[vi].z]; break; }
                        }

                        // 2D координаты общего ребра в текущей системе координат
                        let a0 = v2d[v1];
                        let a1 = v2d[v2];
                        
                        // Вычисляем вектор нормали текущей грани (аппроксимация через Z-компоненту в 2D)
                        let edge_vec = [a1[0] - a0[0], a1[1] - a0[1]];
                        // Мы должны "отразить" 3D вершину в 2D, сохраняя длины и углы.
                        // Вектор от v1 к v3 в 3D
                        let d3d_1 = [mesh.vertices[v3_3d[0] as usize].x - mesh.vertices[v1].x, 
                                    mesh.vertices[v3_3d[0] as usize].y - mesh.vertices[v1].y];
                        
                        // Упрощенная жесткая трансформация (Papercraft core logic)
                        // Находим угол и длину
                        let _len_d3d = (d3d_1[0]*d3d_1[0] + d3d_1[1]*d3d_1[1]).sqrt().max(0.0001);
                        let _len_edge = (edge_vec[0]*edge_vec[0] + edge_vec[1]*edge_vec[1]).sqrt().max(0.0001);
                        
                        // Вычисляем угол поворота на основе 3D координат (через векторное произведение)
                        let ev3d = [mesh.vertices[v2].x - mesh.vertices[v1].x, mesh.vertices[v2].y - mesh.vertices[v1].y, mesh.vertices[v2].z - mesh.vertices[v1].z];
                        let dv3d = [v3_3d[0] - mesh.vertices[v1].x, v3_3d[1] - mesh.vertices[v1].y, v3_3d[2] - mesh.vertices[v1].z];
                        
                        // Z-компонента векторного произведения определяет направление разворота (вверх или вниз от ребра)
                        let cross_z = ev3d[0] * dv3d[1] - ev3d[1] * dv3d[0];
                        let sign = if cross_z < 0.0 { -1.0 } else { 1.0 };

                        // Угол между ребром и вектором к 3-й вершине в 3D
                        let dot = ev3d[0]*dv3d[0] + ev3d[1]*dv3d[1];
                        let det = ev3d[0]*dv3d[1] - ev3d[1]*dv3d[0];
                        let mut angle_3d = det.atan2(dot);

                        // Применяем знак для правильного "загибания" бумаги
                        if sign < 0.0 { angle_3d = -angle_3d; }

                        // Текущий угол ребра в 2D
                        let angle_2d = edge_vec[1].atan2(edge_vec[0]);
                        
                        // Итоговый угол для 3-й вершины в 2D
                        let final_angle = angle_2d + angle_3d;
                        
                        // Длина вектора к 3-й вершине в 3D
                        let len_3d = ((v3_3d[0]-mesh.vertices[v1].x).powi(2) + 
                                      (v3_3d[1]-mesh.vertices[v1].y).powi(2) + 
                                      (v3_3d[2]-mesh.vertices[v1].z).powi(2)).sqrt();

                        // Вычисляем 2D координаты 3-й вершины
                        let v3_idx = nf.vertices.iter().find(|&&vi| vi != v1 && vi != v2).unwrap();
                        v2d[*v3_idx] = [a0[0] + final_angle.cos() * len_3d, a0[1] + final_angle.sin() * len_3d];
                        
                        queue.push_back(nfi);
                    }
                }
            }
        }

        let faces_2d: Vec<Vec<usize>> = mesh.faces.iter().map(|f| f.vertices.clone()).collect();
        let mut area = 0.0;
        for f in &mesh.faces {
            if f.vertices.len() == 3 {
                let v0 = v2d[f.vertices[0]]; let v1 = v2d[f.vertices[1]]; let v2 = v2d[f.vertices[2]];
                area += ((v1[0]-v0[0])*(v2[1]-v0[1]) - (v1[1]-v0[1])*(v2[0]-v0[0])).abs() * 0.5;
            }
        }

        Ok(UnfoldResult {
            vertices_2d: v2d,
            faces: faces_2d,
            island_ids: vec![0; mesh.faces.len()], // Временная заглушка для островов
            metadata: UnfoldMetadata { is_degenerate: area < 0.0001, area_2d: area },
            sheet_count: 1,
        })
    }

    pub mod mds_optimized {
        use super::*;
        pub fn mds_parallel(_mesh: &Mesh, _config: &UnfoldConfig) -> UnfoldResult {
            UnfoldResult::empty()
        }
    }

    pub mod seam_cut {
        use super::*;

        pub struct SeamCutResult {
            pub islands: Vec<Vec<usize>>,
