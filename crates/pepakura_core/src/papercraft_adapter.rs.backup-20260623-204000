use crate::unwrap_types::*;
use std::process::{Command, Stdio};

const PAPERCRAFT_EXE: &str = r"D:\Dev\Papercraft-v2.12-win64\papercraft.exe";

pub fn run_papercraft(obj_data: &str) -> Result<UnwrapResult, String> {
    println!("[Papercraft] Запуск внешнего движка...");

    let mut child = Command::new(PAPERCRAFT_EXE)
        .stdin(Stdio::piped())
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .spawn()
        .map_err(|e| format!("Не удалось запустить papercraft.exe: {}. Проверьте путь.", e))?;

    if let Some(mut stdin) = child.stdin.take() {
        use std::io::Write;
        stdin.write_all(obj_data.as_bytes()).map_err(|e| format!("Ошибка записи в stdin: {}", e))?;
    }

    let output = child.wait_with_output().map_err(|e| format!("Процесс упал: {}", e))?;

    if !output.status.success() {
        let err = String::from_utf8_lossy(&output.stderr);
        return Err(format!("Papercraft завершился с ошибкой:\n{}", err));
    }

    let svg_str = String::from_utf8_lossy(&output.stdout);
    parse_svg_to_unwrap_result(&svg_str)
}

fn parse_svg_to_unwrap_result(svg: &str) -> Result<UnwrapResult, String> {
    let mut pieces = Vec::new();
    let mut current_piece: Option<Piece> = None;

    // Papercraft генерирует пути. Разделяем строку по тегам <path
    for part in svg.split("<path ") {
        if part.is_empty() { continue; }
        
        let tag_end = part.find('>').unwrap_or(0);
        let tag = &part[..tag_end];
        
        let d_attr = get_attr(tag, "d").unwrap_or_default();
        let fill_attr = get_attr(tag, "fill").unwrap_or_else(|| "none".to_string());
        let style_attr = get_attr(tag, "style").unwrap_or_default();
        
        // Является ли этот путь залитым полигоном (клапан)?
        let is_filled = fill_attr != "none" || (style_attr.contains("fill:") && !style_attr.contains("fill:none"));
        
        // Есть ли пунктир (сгиб)?
        let is_dashed = style_attr.contains("stroke-dasharray") || tag.contains("stroke-dasharray");

        let pts = parse_d_path(&d_attr);
        if pts.len() < 2 { continue; }

        if is_filled {
            // Это клапан (Tab)
            if let Some(p) = current_piece.as_mut() {
                p.tabs.push(Tab {
                    polygon: Polygon { points: pts, holes: vec![] },
                    glues_to_piece_id: 0, // В MVP не знаем точное сопоставление
                });
            }
        } else if is_dashed {
            // Это сгиб (Fold)
            if let Some(p) = current_piece.as_mut() {
                if pts.len() >= 2 {
                    p.folds.push(FoldLine {
                        start: pts[0].clone(),
                        end: pts[1].clone(),
                        fold_type: FoldType::Mountain, // Упрощение: считаем всё горным
                        angle: 90.0,
                    });
                }
            }
        } else {
            // Это контур детали (Outline) -> Начинаем новую деталь
            if let Some(p) = current_piece.take() {
                pieces.push(p);
            }
            let area = calc_polygon_area(&pts);
            let perimeter = calc_polygon_perimeter(&pts);
            
            current_piece = Some(Piece {
                id: pieces.len() as u32,
                name: format!("Piece_{}", pieces.len()),
                page_number: 0,
                outline: Polygon { points: pts, holes: vec![] },
                folds: vec![],
                tabs: vec![],
                area,
                perimeter,
            });
        }
    }

    if let Some(p) = current_piece.take() {
        pieces.push(p);
    }

    let total_folds: usize = pieces.iter().map(|p| p.folds.len()).sum();
    let total_tabs: usize = pieces.iter().map(|p| p.tabs.len()).sum();

    Ok(UnwrapResult {
        engine_used: "Papercraft".to_string(),
        pieces,
        pages: vec![Page { page_number: 0, piece_ids: vec![], utilization_percent: 0.0 }],
        metrics: UnwrapMetrics {
            total_pieces: pieces.len() as u32,
            total_pages: 1,
            total_folds: total_folds as u32,
            total_tabs: total_tabs as u32,
            complexity_score: (pieces.len() as f32) * 5.0,
        },
    })
}

// Вспомогательная функция извлечения атрибута из SVG тега
fn get_attr(tag: &str, attr_name: &str) -> Option<String> {
    let search1 = format!("{}=\"", attr_name);
    let search2 = format!("{}='", attr_name);
    
    if let Some(start) = tag.find(&search1) {
        let val_start = start + search1.len();
        if let Some(end) = tag[val_start..].find('"') {
            return Some(tag[val_start..val_start + end].to_string());
        }
    } else if let Some(start) = tag.find(&search2) {
        let val_start = start + search2.len();
        if let Some(end) = tag[val_start..].find('\'') {
            return Some(tag[val_start..val_start + end].to_string());
        }
    }
    None
}

// Примитивный парсер пути SVG (M x y L x y Z)
fn parse_d_path(d: &str) -> Vec<Point2D> {
    let mut points = Vec::new();
    let parts: Vec<&str> = d.split_whitespace().collect();
    let mut i = 0;
    
    while i < parts.len() {
        let cmd = parts[i];
        if cmd == "M" || cmd == "L" {
            if i + 2 < parts.len() {
                if let (Ok(x), Ok(y)) = (parts[i+1].parse::<f32>(), parts[i+2].parse::<f32>()) {
                    points.push(Point2D { x, y });
                }
                i += 3;
            } else { break; }
        } else if cmd == "Z" {
            break;
        } else {
            // Иногда координаты идут без букв (неоптимизированный SVG)
            if let Ok(x) = cmd.parse::<f32>() {
                if i + 1 < parts.len() {
                    if let Ok(y) = parts[i+1].parse::<f32>() {
                        points.push(Point2D { x, y });
                        i += 2;
                        continue;
                    }
                }
            }
            i += 1;
        }
    }
    points
}

fn calc_polygon_area(pts: &[Point2D]) -> f32 {
    let n = pts.len();
    if n < 3 { return 0.0; }
    let mut area = 0.0;
    for i in 0..n {
        let j = (i + 1) % n;
        area += pts[i].x * pts[j].y - pts[j].x * pts[i].y;
    }
    area.abs() * 0.5
}

fn calc_polygon_perimeter(pts: &[Point2D]) -> f32 {
    if pts.is_empty() { return 0.0; }
    let mut perimeter = 0.0;
    for i in 0..pts.len() - 1 {
        let dx = pts[i+1].x - pts[i].x;
        let dy = pts[i+1].y - pts[i].y;
        perimeter += (dx*dx + dy*dy).sqrt();
    }
    let dx = pts[0].x - pts.last().unwrap().x;
    let dy = pts[0].y - pts.last().unwrap().y;
    perimeter += (dx*dx + dy*dy).sqrt();
    perimeter
}
