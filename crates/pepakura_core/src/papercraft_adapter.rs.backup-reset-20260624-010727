use std::path::PathBuf;
use std::process::Command;

use anyhow::{bail, Result};

use crate::unwrap_types::{UnwrapOptions, UnwrapResult, UnwrapEngine, UnwrapGlobalMetrics, Piece};

pub fn papercraft_exe_probe() -> Result<String> {
    let exe = PathBuf::from(r"D:\Dev\Papercraft-v2.12-win64\papercraft.exe");

    if !exe.exists() {
        bail!("papercraft.exe not found: {}", exe.display());
    }

    let out = Command::new(&exe)
        .arg("--help")
        .output()?;

    if !out.status.success() {
        bail!("papercraft.exe --help failed");
    }

    Ok(String::from_utf8_lossy(&out.stdout).to_string())
}

pub fn papercraft_exe_unwrap(_input_obj: &str, _options: &UnwrapOptions) -> Result<UnwrapResult> {
    // Заглушка: реальный CLI заполним после того, как увидим вывод --help.
    let result = UnwrapResult {
        engine: "PapercraftExe".to_string(),
        options_used: UnwrapOptions {
            engine: UnwrapEngine::PapercraftExe,
            scale: 1.0,
            page_width: 210.0,
            page_height: 297.0,
            margin: 10.0,
            allow_tabs: true,
        },
        pages: Vec::new(),
        pieces: Vec::<Piece>::new(),
        global_metrics: UnwrapGlobalMetrics::default(),
    };

    Ok(result)
}