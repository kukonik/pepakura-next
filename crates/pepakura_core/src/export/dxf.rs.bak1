// ============================================================
// [R4-v1 / EXP60] Реальный векторный DXF-экспорт развёртки.
// std-only: ASCII DXF R12 (AC1009) собирается вручную как текст,
// внешние крейты не используются.
// Подход = pdf.rs [R3-v2/EXP54]: внутренние рёбра -> сгибы
// (выпуклое - слой PEP_MOUNTAIN/красный, вогнутое - PEP_VALLEY/синий),
// граничные -> рез (PEP_CUT/белый), связные компоненты граней =
// детали, единый масштаб, раскладка полками по ширине страницы,
// номера деталей P1..Pn (слой PEP_LABEL/зелёный). Единицы = units.
// Публичный API сохранён: DxfExportConfig/DxfUnits/DxfExportError/
// DxfExportResult/export_dxf/export_dxf_to_file.
// ============================================================

use std::collections::{HashMap, HashSet};
use std::path::Path;

use crate::export::PageSize;
use crate::unfold::UnfoldedMesh;

/// Конфигурация экспорта в DXF.
#[derive(Debug, Clone)]
pub struct DxfExportConfig {
    /// Размер страницы (задаёт ширину раскладочной полки)
    pub page_size: PageSize,
    /// Масштаб: мм на единицу модели
    pub scale: f64,
    /// Экспортировать линии реза
    pub export_cut_lines: bool,
    /// Экспортировать линии сгиба
    pub export_fold_lines: bool,
    /// Экспортировать номера деталей
    pub export_part_numbers: bool,
    /// Единицы измерения
    pub units: DxfUnits,
}

/// Единицы измерения DXF.
#[derive(Debug, Clone, Copy, Default)]
pub enum DxfUnits {
    /// Миллиметры
    #[default]
    Millimeters,
    /// Сантиметры
    Centimeters,
    /// Дюймы
    Inches,
    /// Метры
    Meters,
}

impl Default for DxfExportConfig {
    fn default() -> Self {
        Self {
            page_size: PageSize::A4,
            scale: 1.0,
            export_cut_lines: true,
            export_fold_lines: true,
            export_part_numbers: true,
            units: DxfUnits::Millimeters,
        }
    }
}

/// Ошибки экспорта DXF.
#[derive(Debug, thiserror::Error)]
pub enum DxfExportError {
    #[error("Ошибка записи: {0}")]
    IoError(#[from] std::io::Error),

    #[error("Ошибка DXF: {0}")]
    DxfError(String),

    #[error("Пустой меш")]
    EmptyMesh,

    #[error("DXF экспорт временно отключён")]
    Disabled,
}

/// Результат экспорта DXF.
#[derive(Debug, Clone)]
pub struct DxfExportResult {
    /// DXF данные в виде строки
    pub content: String,
    /// Количество слоёв
    pub layer_count: usize,
    /// Количество объектов
    pub entity_count: usize,
}

const MARGIN_MM: f64 = 10.0;
const GAP_MM: f64 = 2.0;
const ROW_GAP_MM: f64 = 4.0;
const TEXT_H_MM: f64 = 3.0;

#[derive(Clone, Copy, PartialEq, Eq, Hash)]
enum LineKind { Cut, Mountain, Valley }

impl LineKind {
    fn layer(self) -> &'static str {
        match self {
            LineKind::Cut => "PEP_CUT",
            LineKind::Mountain => "PEP_MOUNTAIN",
            LineKind::Valley => "PEP_VALLEY",
        }
    }
    fn aci(self) -> i32 {
        match self {
            LineKind::Cut => 7,
            LineKind::Mountain => 1,
            LineKind::Valley => 5,
        }
    }
}

/// Отрезок в мм (масштаб применяется при раскладке), y - вверх.
struct Seg { x1: f64, y1: f64, x2: f64, y2: f64, kind: LineKind }

struct RawMesh {
    verts2d: Vec<(f64, f64)>,
    faces: Vec<Vec<usize>>,
    verts3d: Option<Vec<[f64; 3]>>,
}

fn page_width_mm(size: &PageSize) -> f64 {
    match size {
        PageSize::A4 => 210.0,
        PageSize::A3 => 297.0,
        PageSize::A2 => 420.0,
        PageSize::A1 => 594.0,
        PageSize::Custom { width_mm, .. } => *width_mm,
    }
}

fn raw_from_unfolded(u: &UnfoldedMesh) -> RawMesh {
    let verts2d: Vec<(f64, f64)> = u.vertices_2d.iter().map(|p| (p[0], p[1])).collect();
    let faces: Vec<Vec<usize>> = u.faces.iter().map(|f| f.vertices.to_vec()).collect();
    let verts3d = Some(u.source_mesh.vertices.iter()
        .map(|v| [v.position[0], v.position[1], v.position[2]])
        .collect());
    RawMesh { verts2d, faces, verts3d }
}

fn face_normal3d(verts3d: &[[f64; 3]], f: &[usize]) -> Option<[f64; 3]> {
    if f.len() < 3 { return None; }
    let a = *verts3d.get(f[0])?;
    let b = *verts3d.get(f[1])?;
    let c = *verts3d.get(f[2])?;
    let u = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];
    let w = [c[0] - a[0], c[1] - a[1], c[2] - a[2]];
    let n = [u[1] * w[2] - u[2] * w[1], u[2] * w[0] - u[0] * w[2], u[0] * w[1] - u[1] * w[0]];
    let l = (n[0] * n[0] + n[1] * n[1] + n[2] * n[2]).sqrt();
    if l < 1e-12 { return None; }
    Some([n[0] / l, n[1] / l, n[2] / l])
}

/// Классификация рёбер: 1 грань -> Cut, 2+ -> сгиб (mountain/valley по нормали).
fn classify_edges(mesh: &RawMesh) -> HashMap<(usize, usize), LineKind> {
    let mut edge_faces: HashMap<(usize, usize), Vec<usize>> = HashMap::new();
    for (fi, f) in mesh.faces.iter().enumerate() {
        let n = f.len();
        for k in 0..n {
            let a = f[k];
            let b = f[(k + 1) % n];
            if a == b || a >= mesh.verts2d.len() || b >= mesh.verts2d.len() { continue; }
            let key = if a < b { (a, b) } else { (b, a) };
            let e = edge_faces.entry(key).or_insert_with(Vec::new);
            if !e.contains(&fi) { e.push(fi); }
        }
    }

    let mut out: HashMap<(usize, usize), LineKind> = HashMap::new();
    for (key, fs) in edge_faces {
        if fs.len() == 1 {
            out.insert(key, LineKind::Cut);
            continue;
        }
        let mut kind = LineKind::Valley;
        if let Some(v3) = &mesh.verts3d {
            if fs.len() >= 2 {
                let n1 = face_normal3d(v3, &mesh.faces[fs[0]]);
                if let Some(n1) = n1 {
                    let f2 = &mesh.faces[fs[1]];
                    if let Some(&c) = f2.iter().find(|&&x| x != key.0 && x != key.1) {
                        if let (Some(cp), Some(ap)) = (v3.get(c), v3.get(key.0)) {
                            let d = n1[0] * (cp[0] - ap[0]) + n1[1] * (cp[1] - ap[1]) + n1[2] * (cp[2] - ap[2]);
                            kind = if d <= 0.0 { LineKind::Mountain } else { LineKind::Valley };
                        }
                    }
                }
            }
        }
        out.insert(key, kind);
    }
    out
}

/// Связные компоненты граней (детали) через рёбра, общие для 2+ граней.
fn face_components(mesh: &RawMesh) -> Vec<Vec<usize>> {
    let mut edge_faces: HashMap<(usize, usize), Vec<usize>> = HashMap::new();
    for (fi, f) in mesh.faces.iter().enumerate() {
        let n = f.len();
        for k in 0..n {
            let a = f[k];
            let b = f[(k + 1) % n];
            if a == b { continue; }
            let key = if a < b { (a, b) } else { (b, a) };
            let e = edge_faces.entry(key).or_insert_with(Vec::new);
            if !e.contains(&fi) { e.push(fi); }
        }
    }

    let mut adj: HashMap<usize, Vec<usize>> = HashMap::new();
    for (_key, fs) in &edge_faces {
        if fs.len() < 2 { continue; }
        for i in 0..fs.len() {
            for j in (i + 1)..fs.len() {
                let a = fs[i];
                let b = fs[j];
                adj.entry(a).or_insert_with(Vec::new).push(b);
                adj.entry(b).or_insert_with(Vec::new).push(a);
            }
        }
    }

    let mut comp = vec![usize::MAX; mesh.faces.len()];
    let mut comps: Vec<Vec<usize>> = Vec::new();
    for fi in 0..mesh.faces.len() {
        if comp[fi] != usize::MAX { continue; }
        let mut members = vec![fi];
        comp[fi] = 0;
        let mut stack = vec![fi];
        while let Some(x) = stack.pop() {
            if let Some(nbs) = adj.get(&x) {
                for &nb in nbs {
                    if comp[nb] == usize::MAX {
                        comp[nb] = 0;
                        members.push(nb);
                        stack.push(nb);
                    }
                }
            }
        }
        comps.push(members);
    }
    comps
}

struct PartGeom { minx: f64, miny: f64, maxx: f64, maxy: f64 }

struct Placement {
    segs: Vec<Seg>,
    labels: Vec<(f64, f64, String)>,
}

fn units_factor(u: &DxfUnits) -> f64 {
    match u {
        DxfUnits::Millimeters => 1.0,
        DxfUnits::Centimeters => 0.1,
        DxfUnits::Inches => 1.0 / 25.4,
        DxfUnits::Meters => 0.001,
    }
}

fn insunits_code(u: &DxfUnits) -> i32 {
    match u {
        DxfUnits::Millimeters => 4,
        DxfUnits::Centimeters => 5,
        DxfUnits::Inches => 1,
        DxfUnits::Meters => 6,
    }
}

fn layout_parts(mesh: &RawMesh, config: &DxfExportConfig) -> Result<(Vec<Placement>, f64, usize), String> {
    let kinds = classify_edges(mesh);
    let comps = face_components(mesh);
    let n_cuts = kinds.values().filter(|k| **k == LineKind::Cut).count();
    let n_folds = kinds.len() - n_cuts;
    eprintln!("[EXP60] DXF: граней={} деталей={} рёбер: рез={} сгибов={}", mesh.faces.len(), comps.len(), n_cuts, n_folds);
    if comps.is_empty() { return Err("Нет деталей".to_string()); }

    let mut parts: Vec<PartGeom> = Vec::new();
    for members in &comps {
        let mut minx = f64::MAX; let mut miny = f64::MAX;
        let mut maxx = f64::MIN; let mut maxy = f64::MIN;
        for &fi in members {
            for &vi in &mesh.faces[fi] {
                if vi >= mesh.verts2d.len() { continue; }
                let (x, y) = mesh.verts2d[vi];
                if x < minx { minx = x; }
                if y < miny { miny = y; }
                if x > maxx { maxx = x; }
                if y > maxy { maxy = y; }
            }
        }
        parts.push(PartGeom { minx, miny, maxx, maxy });
    }

    // Полка ограничена только по ширине страницы (высота DXF-листа свободна).
    let row_w = (page_width_mm(&config.page_size) - 2.0 * MARGIN_MM).max(1.0);
    let s0 = if config.scale > 1e-9 { config.scale } else { 1.0 };
    let mut eff = s0;
    for p in &parts {
        let w_u = (p.maxx - p.minx).abs();
        if w_u * s0 > row_w && w_u > 1e-9 { eff = eff.min(row_w / w_u); }
    }
    if !eff.is_finite() || eff <= 1e-9 { eff = 1.0; }

    // Сортировка деталей по высоте (убыв.) для раскладки полками.
    let mut order: Vec<usize> = (0..parts.len()).collect();
    order.sort_by(|&a, &b| {
        let ha = (parts[b].maxy - parts[b].miny).abs();
        let hb = (parts[a].maxy - parts[a].miny).abs();
        ha.partial_cmp(&hb).unwrap_or(std::cmp::Ordering::Equal)
    });

    let mut placements: Vec<Placement> = Vec::new();
    let mut row_x: f64 = 0.0;
    let mut row_h: f64 = 0.0;
    let mut row_y: f64 = 0.0;

    for &pi in &order {
        let p = &parts[pi];
        let w_mm = (p.maxx - p.minx).abs() * eff;
        let h_mm = (p.maxy - p.miny).abs() * eff;

        if row_x > 0.0 && row_x + w_mm > row_w {
            row_y += row_h + ROW_GAP_MM;
            row_x = 0.0;
            row_h = 0.0;
        }

        let ox = row_x;
        let oy = row_y;
        let tx = |x: f64| MARGIN_MM + ox + (x - p.minx) * eff;
        let ty = |y: f64| MARGIN_MM + oy + (y - p.miny) * eff;

        let mut segs: Vec<Seg> = Vec::new();
        let mut drawn: HashSet<(usize, usize)> = HashSet::new();
        for &fi in &comps[pi] {
            let f = &mesh.faces[fi];
            let n = f.len();
            for k in 0..n {
                let a = f[k];
                let b = f[(k + 1) % n];
                if a == b || a >= mesh.verts2d.len() || b >= mesh.verts2d.len() { continue; }
                let key = if a < b { (a, b) } else { (b, a) };
                if !drawn.insert(key) { continue; }
                let kind = *kinds.get(&key).unwrap_or(&LineKind::Cut);
                let is_fold = kind != LineKind::Cut;
                if is_fold && !config.export_fold_lines { continue; }
                if !is_fold && !config.export_cut_lines { continue; }
                let (ax, ay) = mesh.verts2d[a];
                let (bx, by) = mesh.verts2d[b];
                if !(ax.is_finite() && ay.is_finite() && bx.is_finite() && by.is_finite()) { continue; }
                segs.push(Seg { x1: tx(ax), y1: ty(ay), x2: tx(bx), y2: ty(by), kind });
            }
        }

        let mut labels: Vec<(f64, f64, String)> = Vec::new();
        if config.export_part_numbers {
            let mut cx = 0.0; let mut cy = 0.0; let mut cnt = 0.0;
            for &fi in &comps[pi] {
                for &vi in &mesh.faces[fi] {
                    if vi >= mesh.verts2d.len() { continue; }
                    let (x, y) = mesh.verts2d[vi];
                    cx += tx(x); cy += ty(y); cnt += 1.0;
                }
            }
            if cnt > 0.0 {
                labels.push((cx / cnt + 1.0, cy / cnt + 1.0, format!("P{}", pi + 1)));
            }
        }

        placements.push(Placement { segs, labels });

        row_x += w_mm + GAP_MM;
        if h_mm > row_h { row_h = h_mm; }
    }

    Ok((placements, eff, comps.len()))
}

fn fmt_dxf(x: f64) -> String {
    format!("{:.4}", x)
}

fn push_pair(out: &mut String, code: i32, s: &str) {
    out.push_str(&code.to_string());
    out.push('\n');
    out.push_str(s);
    out.push('\n');
}

fn push_pair_f(out: &mut String, code: i32, v: f64) {
    push_pair(out, code, &fmt_dxf(v));
}

fn build_dxf(placements: &[Placement], eff: f64, config: &DxfExportConfig) -> (String, usize, usize) {
    let uf = units_factor(&config.units);
    let mut out = String::new();
    let mut entities = 0usize;

    // Габариты (в единицах) для $EXTMIN/$EXTMAX.
    let mut minx = f64::MAX; let mut miny = f64::MAX;
    let mut maxx = f64::MIN; let mut maxy = f64::MIN;
    for pl in placements {
        for s in &pl.segs {
            minx = minx.min(s.x1).min(s.x2);
            maxx = maxx.max(s.x1).max(s.x2);
            miny = miny.min(s.y1).min(s.y2);
            maxy = maxy.max(s.y1).max(s.y2);
        }
    }
    if minx > maxx { minx = 0.0; maxx = 0.0; miny = 0.0; maxy = 0.0; }

    // --- HEADER ---
    push_pair(&mut out, 0, "SECTION");
    push_pair(&mut out, 2, "HEADER");
    push_pair(&mut out, 9, "$ACADVER");
    push_pair(&mut out, 1, "AC1009");
    push_pair(&mut out, 9, "$INSUNITS");
    push_pair(&mut out, 70, &insunits_code(&config.units).to_string());
    push_pair(&mut out, 9, "$EXTMIN");
    push_pair_f(&mut out, 10, minx * uf);
    push_pair_f(&mut out, 20, miny * uf);
    push_pair_f(&mut out, 30, 0.0);
    push_pair(&mut out, 9, "$EXTMAX");
    push_pair_f(&mut out, 10, maxx * uf);
    push_pair_f(&mut out, 20, maxy * uf);
    push_pair_f(&mut out, 30, 0.0);
    push_pair(&mut out, 0, "ENDSEC");

    // --- TABLES ---
    push_pair(&mut out, 0, "SECTION");
    push_pair(&mut out, 2, "TABLES");
    push_pair(&mut out, 0, "TABLE");
    push_pair(&mut out, 2, "LTYPE");
    push_pair(&mut out, 70, "1");
    push_pair(&mut out, 0, "LTYPE");
    push_pair(&mut out, 2, "CONTINUOUS");
    push_pair(&mut out, 70, "0");
    push_pair(&mut out, 3, "Solid line");
    push_pair(&mut out, 72, "65");
    push_pair(&mut out, 73, "0");
    push_pair(&mut out, 40, "0.0");
    push_pair(&mut out, 0, "ENDTAB");

    let mut layers: Vec<(&'static str, i32)> = Vec::new();
    for k in [LineKind::Cut, LineKind::Mountain, LineKind::Valley] {
        layers.push((k.layer(), k.aci()));
    }
    layers.push(("PEP_LABEL", 3));

    push_pair(&mut out, 0, "TABLE");
    push_pair(&mut out, 2, "LAYER");
    push_pair(&mut out, 70, &layers.len().to_string());
    for (name, aci) in layers {
        push_pair(&mut out, 0, "LAYER");
        push_pair(&mut out, 2, name);
        push_pair(&mut out, 70, "0");
        push_pair(&mut out, 62, &aci.to_string());
        push_pair(&mut out, 6, "CONTINUOUS");
    }
    push_pair(&mut out, 0, "ENDTAB");
    push_pair(&mut out, 0, "ENDSEC");

    // --- ENTITIES ---
    push_pair(&mut out, 0, "SECTION");
    push_pair(&mut out, 2, "ENTITIES");
    for pl in placements {
        for s in &pl.segs {
            push_pair(&mut out, 0, "LINE");
            push_pair(&mut out, 8, s.kind.layer());
            push_pair_f(&mut out, 10, s.x1 * uf);
            push_pair_f(&mut out, 20, s.y1 * uf);
            push_pair_f(&mut out, 30, 0.0);
            push_pair_f(&mut out, 11, s.x2 * uf);
            push_pair_f(&mut out, 21, s.y2 * uf);
            push_pair_f(&mut out, 31, 0.0);
            entities += 1;
        }
    }
    for (i, pl) in placements.iter().enumerate() {
        for (lx, ly, text) in &pl.labels {
            push_pair(&mut out, 0, "TEXT");
            push_pair(&mut out, 8, "PEP_LABEL");
            push_pair_f(&mut out, 10, lx * uf);
            push_pair_f(&mut out, 20, ly * uf);
            push_pair_f(&mut out, 30, 0.0);
            push_pair_f(&mut out, 40, TEXT_H_MM * uf);
            push_pair(&mut out, 1, text);
            entities += 1;
        }
        if i == 0 {
            let note = format!("Pepakura Next DXF | scale {:.3} mm/unit", eff);
            push_pair(&mut out, 0, "TEXT");
            push_pair(&mut out, 8, "PEP_LABEL");
            push_pair_f(&mut out, 10, minx * uf);
            push_pair_f(&mut out, 20, (miny - TEXT_H_MM * 2.0) * uf);
            push_pair_f(&mut out, 30, 0.0);
            push_pair_f(&mut out, 40, TEXT_H_MM * uf);
            push_pair(&mut out, 1, &note);
            entities += 1;
        }
    }
    push_pair(&mut out, 0, "ENDSEC");
    push_pair(&mut out, 0, "EOF");

    (out, entities, 4)
}

/// Экспортирует развёрнутый меш в DXF.
///
/// # Аргументы
/// * `unfolded` - развёрнутый меш
/// * `config` - конфигурация экспорта
///
/// # Возвращает
/// * `Ok(DxfExportResult)` - результат экспорта
/// * `Err(DxfExportError)` - ошибка
pub fn export_dxf(
    unfolded: &UnfoldedMesh,
    config: &DxfExportConfig,
) -> Result<DxfExportResult, DxfExportError> {
    if unfolded.vertices_2d.is_empty() {
        return Err(DxfExportError::DxfError("Нет 2D-координат вершин".to_string()));
    }
    if unfolded.faces.is_empty() {
        return Err(DxfExportError::EmptyMesh);
    }
    let mesh = raw_from_unfolded(unfolded);
    let (placements, eff, parts_total) = layout_parts(&mesh, config).map_err(DxfExportError::DxfError)?;
    let (content, entities, layer_n) = build_dxf(&placements, eff, config);
    eprintln!("[EXP60] DXF: деталей={} объектов={} слоёв={} масштаб={:.4} мм/ед.", parts_total, entities, layer_n, eff);
    Ok(DxfExportResult { content, layer_count: layer_n, entity_count: entities })
}

/// Экспортирует развёрнутый меш в DXF файл (папки создаются автоматически).
pub fn export_dxf_to_file(
    unfolded: &UnfoldedMesh,
    config: &DxfExportConfig,
    path: &str,
) -> Result<(), DxfExportError> {
    let result = export_dxf(unfolded, config)?;
    if let Some(parent) = Path::new(path).parent() {
        if !parent.as_os_str().is_empty() {
            let _ = std::fs::create_dir_all(parent);
        }
    }
    std::fs::write(path, result.content)?;
    eprintln!("[EXP60] DXF записан: {} ({} объектов)", path, result.entity_count);
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::geometry::{Mesh, Vertex, Face};

    fn create_test_triangle() -> UnfoldedMesh {
        let mut mesh = Mesh::new("Triangle");
        mesh.add_vertex(Vertex::new(0, [0.0, 0.0, 0.0]));
        mesh.add_vertex(Vertex::new(1, [1.0, 0.0, 0.0]));
        mesh.add_vertex(Vertex::new(2, [0.5, 1.0, 0.0]));
        mesh.add_face(Face::new(0, 1, 2));

        UnfoldedMesh {
            vertices_2d: vec![[0.0, 0.0], [1.0, 0.0], [0.5, 1.0]],
            faces: mesh.faces.clone(),
            source_mesh: mesh,
            metadata: Default::default(),
        }
    }

    #[test]
    fn test_export_dxf_triangle() {
        let unfolded = create_test_triangle();
        let config = DxfExportConfig::default();
        let result = export_dxf(&unfolded, &config).unwrap();
        assert!(result.content.contains("EOF"));
        assert!(result.content.contains("AC1009"));
        assert!(result.content.contains("PEP_CUT"));
        assert!(result.entity_count >= 4);
        assert_eq!(result.layer_count, 4);
    }

    #[test]
    fn test_export_dxf_empty_mesh() {
        let unfolded = UnfoldedMesh {
            vertices_2d: vec![],
            faces: vec![],
            source_mesh: Mesh::new("Empty"),
            metadata: Default::default(),
        };
        let config = DxfExportConfig::default();
        let result = export_dxf(&unfolded, &config);
        assert!(result.is_err());
    }
}