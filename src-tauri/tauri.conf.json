{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pepakura Next",
  "version": "0.1.0",
  "identifier": "com.pepakura.next",
  "build": {
    "beforeDevCommand": "pnpm --dir D:\\Dev\\pepakura-next\\packages\\ui-desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir D:\\Dev\\pepakura-next\\packages\\ui-desktop build",
    "frontendDist": "../packages/ui-desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pepakura Next",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}