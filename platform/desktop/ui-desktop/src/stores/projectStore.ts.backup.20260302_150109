import { defineStore } from 'pinia';
import { ref, computed, reactive } from 'vue';
// Если Map не импортирован в auto-imports, добавь импорт:
// import { Map } from 'vue'; 

// Интерфейсы (опционально, для типизации)
interface ModelStats {
  vertices: number;
  faces: number;
  edges: number;
  surfaceArea: number;
  volume: number;
  bounds?: any;
  error?: string;
}

export const useProjectStore = defineStore('project', () => {
  // === Core State ===
  const modelPath = ref<string | null>(null);
  const svgContent = ref<string>('');
  const theme = ref<'light' | 'dark' | 'auto'>('dark');
  const modelInfo = ref<ModelStats | null>(null);
  const projectName = ref<string>('Без названия');
  const lastModified = ref<string>('');
  const isDirty = ref<boolean>(false);

  // === UI / Editor state ===
  const selectedPartId = ref<string | null>(null);
  const partTransforms = ref<Map<string, { x: number; y: number; rotation: number }>>(new Map());
  const editMode = ref<boolean>(false);
  const searchQuery = ref<string>('');
  const activeTool = ref<string>('import');
  const materialSize = ref<string>('A4');
  const flapWidth = ref<number>(10);
  const showNumbers = ref<boolean>(true);
  const showFolds = ref<boolean>(true);
  const aiTip = ref<string>('');
  const detailCount = ref<number>(0);
  const statusMessage = ref<string>('Готово');
  const recentProjects = ref<Array<{ name: string; path: string }>>([]);
  const unfoldedAt = ref<string>('');
  const unfoldStats = ref<any>(null);

  // === Actions: Core ===
  const setModelPath = (path: string) => {
    modelPath.value = path;
    isDirty.value = true;
  };

  const setSvgContent = (svg: string) => {
    svgContent.value = svg;
    isDirty.value = true;
  };

  const markSaved = () => { isDirty.value = false; };

  // === Actions: Part transforms ===
  const setSelectedPartId = (id: string | null) => {
    selectedPartId.value = id;
  };

  const setPartTransform = ({ id, transform }: { id: string; transform: { x: number; y: number; rotation: number } }) => {
    partTransforms.value.set(id, transform);
    isDirty.value = true;
  };

  const getPartTransform = (id: string) => partTransforms.value.get(id);

  const clearPartTransforms = () => {
    partTransforms.value.clear();
    selectedPartId.value = null;
  };

  // === Actions: Editor UI ===
  const setEditMode = (value: boolean) => { editMode.value = value };
  const setSearchQuery = (value: string) => { searchQuery.value = value };
  const switchTool = (tool: string) => { activeTool.value = tool };
  const setMaterialSize = (size: string) => { materialSize.value = size };
  const setFlapWidth = (width: number) => {
    flapWidth.value = width;
    isDirty.value = true;
  };
  const toggleShowNumbers = () => { showNumbers.value = !showNumbers.value };
  const toggleShowFolds = () => { showFolds.value = !showFolds.value };
  const setAiTip = (tip: string) => { aiTip.value = tip };
  const setDetailCount = (count: number) => { detailCount.value = count };
  const setStatusMessage = (message: string) => { statusMessage.value = message };

  return {
    // Core
    modelPath,
    svgContent,
    theme,
    modelInfo,
    projectName,
    lastModified,
    isDirty,
    setModelPath,
    setSvgContent,
    markSaved,
    // Part transforms
    selectedPartId,
    partTransforms,
    setSelectedPartId,
    setPartTransform,
    getPartTransform,
    clearPartTransforms,
    // Editor UI
    editMode,
    setEditMode,
    searchQuery,
    setSearchQuery,
    activeTool,
    switchTool,
    materialSize,
    setMaterialSize,
    flapWidth,
    setFlapWidth,
    showNumbers,
    toggleShowNumbers,
    showFolds,
    toggleShowFolds,
    aiTip,
    setAiTip,
    detailCount,
    setDetailCount,
    statusMessage,
    setStatusMessage,
    // Extras
    recentProjects,
    unfoldedAt,
    unfoldStats
  };
});