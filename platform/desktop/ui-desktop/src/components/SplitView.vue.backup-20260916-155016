<template>
  <div style="display: flex; height: 100vh; background: #ffffff; color: #ccc; font-family: sans-serif;">
    <div style="flex: 1; border-right: 1px solid #333;">
      <ModelViewer3D :meshData="objData" :mtlData="mtlData" :textureMap="textureMap" />
    </div>

    <div style="flex: 1; border-right: 1px solid #333; display: flex; flex-direction: column; background: #ffffff;">
      <div style="padding: 10px; border-bottom: 1px solid #333; display: flex; gap: 10px; align-items: center;">
        <span style="font-size: 14px; font-weight: bold;">2D Развёртка</span>
        <label style="font-size: 12px; display: flex; align-items: center; gap: 4px;">
          <input type="checkbox" v-model="showWireframe2D" @change="draw2D" checked> Сетка
        </label>
        <label style="font-size: 12px; display: flex; align-items: center; gap: 4px;">
          <input type="checkbox" v-model="showIslands2D" @change="draw2D" checked> Острова
        </label>
      </div>
      <div style="flex: 1; position: relative;">
        <canvas ref="canvas2D" style="width: 100%; height: 100%;"></canvas>
      </div>
    </div>

    <div style="width: 300px; display: flex; flex-direction: column; padding: 20px; background: #252526;">
      <button @click="handleLoadObj" style="padding: 10px; margin-bottom: 10px; cursor: pointer; background: #0e639c; color: white; border: none; width: 100%;">
        Загрузить .obj файл
      </button>
      <button @click="doUnfold" :disabled="!objData || isUnfolding" style="padding: 10px; margin-bottom: 10px; cursor: pointer; background: #333; color: white; border: 1px solid #555; width: 100%;">
        {{ isUnfolding ? 'Обработка...' : 'Развернуть (MST-Seam)' }}
      </button>
      <button @click="callOrchestrator" :disabled="!objData || isAiThinking" style="padding: 10px; margin-bottom: 20px; cursor: pointer; background: #5a1e1e; color: white; border: 1px solid #771e1e; width: 100%;">
        {{ isAiThinking ? 'AI думает...' : '🤖 AI Анализ геометрии' }}
      </button>
      <button @click="handleExport"  style="z-index: 9999; pointer-events: auto; padding: 10px; margin-bottom: 20px; cursor: pointer; background: #0e639c; color: white; border: none; width: 100%;">📄 Экспорт PDF</button>

      <div style="flex: 1; overflow: auto; background: #ffffff; padding: 10px; border-radius: 4px; font-family: monospace; font-size: 12px;">
        <div v-if="rustResult" style="color: #9cdcfe; margin-bottom: 10px; white-space: pre-wrap;">{{ rustResult }}</div>
        <div v-if="aiError" style="color: #f48771; margin-bottom: 10px; white-space: pre-wrap;">AI Ошибка: {{ aiError }}</div>
        <div v-if="aiResult" style="color: #b5cea8; margin-bottom: 10px; white-space: pre-wrap;">🤖 AI Ответ:\n{{ aiResult }}</div>
        <div v-if="!objData" style="color: #666;">Файл не загружен</div>
      </div>
    </div>
  </div>
</template>
<script setup lang="ts">
import { ref, onMounted, onUnmounted } from 'vue';
import { invoke } from '@tauri-apps/api/core';
import { open, readTextFile } from '@tauri-apps/plugin-fs';

// Заглушки для переменных из шаблона, чтобы не было ошибок
const objData = ref('');
const mtlData = ref('');
const textureMap = ref(null);
const showWireframe2D = ref(false);
const showIslands2D = ref(true);
const isUnfolding = ref(false);
const rustResult = ref(null);
const aiError = ref(null);
const aiResult = ref(null);

const canvas2D = ref(null);
const unfoldData = ref(null);
const currentObjData = ref('');
const logMessages = ref([]);

const view2D = ref({ scale: 1, offsetX: 0, offsetY: 0 });
let isDragging = false;
let lastX = 0;
let lastY = 0;

let cachedPieces = null;
let cachedDataRef = null;

const getPieces = () => {
  if (cachedDataRef === unfoldData.value) return cachedPieces;
  cachedDataRef = unfoldData.value;
  
  const data = unfoldData.value;
  const vertices2d = data.vertices_2d || [];
  const faces = data.faces || [];
  if (vertices2d.length === 0 || faces.length === 0) {
    cachedPieces = data.pieces || [];
    return cachedPieces;
  }

  if (data.pieces && data.pieces.length > 0) {
    cachedPieces = data.pieces;
    return cachedPieces;
  }

  const parent = Array.from({length: vertices2d.length}, (_, i) => i);
  const find = (i) => {
    if (parent[i] === i) return i;
    parent[i] = find(parent[i]);
    return parent[i];
  };
  const union = (i, j) => {
    const rootI = find(i);
    const rootJ = find(j);
    if (rootI !== rootJ) parent[rootI] = rootJ;
  };

  for (const f of faces) {
    if (f.length < 3) continue;
    for (let i = 0; i < f.length - 1; i++) union(f[i], f[i+1]);
    union(f[0], f[f.length - 1]);
  }

  const islands = {};
  for (const f of faces) {
    if (f.length < 3) continue;
    const root = find(f[0]);
    if (!islands[root]) islands[root] = { boundary: [] };
    for (let i = 0; i < f.length; i++) {
      const a = f[i];
      const b = f[(i + 1) % f.length];
      const key = a < b ? `${a}-${b}` : `${b}-${a}`;
      islands[root].boundary.push({ a, b, key });
    }
  }

  const pieces = [];
  for (const id in islands) {
    const edgeMap = {};
    for (const e of islands[id].boundary) {
      if (edgeMap[e.key]) edgeMap[e.key].count++;
      else edgeMap[e.key] = { ...e, count: 1 };
    }
    
    const boundaryEdges = [];
    const internalEdges = [];
    for (const key in edgeMap) {
      if (edgeMap[key].count === 1) boundaryEdges.push(edgeMap[key]);
      else internalEdges.push(edgeMap[key]);
    }

    const outlineIndices = [];
    if (boundaryEdges.length > 0) {
      const edgeMapByVertex = {};
      for (const e of boundaryEdges) {
        if (!edgeMapByVertex[e.a]) edgeMapByVertex[e.a] = [];
        if (!edgeMapByVertex[e.b]) edgeMapByVertex[e.b] = [];
        edgeMapByVertex[e.a].push(e.b);
        edgeMapByVertex[e.b].push(e.a);
      }
      
      let current = boundaryEdges[0].a;
      let prev = -1;
      const visitedEdges = new Set();
      for (let i = 0; i < boundaryEdges.length; i++) {
        outlineIndices.push(current);
        const next = edgeMapByVertex[current].find(v => v !== prev && !visitedEdges.has(`${Math.min(current, v)}-${Math.max(current, v)}`));
        if (next === undefined) break;
        visitedEdges.add(`${Math.min(current, next)}-${Math.max(current, next)}`);
        prev = current;
        current = next;
      }
    }
    
    // Конвертируем индексы в координаты {x, y}
    const points = outlineIndices.map(idx => ({
      x: vertices2d[idx][0],
      y: vertices2d[idx][1]
    }));

    const folds = internalEdges.map(e => ({
      a: e.a,
      b: e.b
    }));

    pieces.push({ id, outline: { points }, folds });
  }
  
  cachedPieces = pieces;
  return cachedPieces;
};

const draw2D = () => {
  const canvas = canvas2D.value;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const dpr = window.devicePixelRatio || 1;
  const w = canvas.clientWidth;
  const h = canvas.clientHeight;
  if (w === 0 || h === 0) return;

  const targetW = Math.round(w * dpr);
  const targetH = Math.round(h * dpr);
  if (canvas.width !== targetW || canvas.height !== targetH) {
    canvas.width = targetW;
    canvas.height = targetH;
  }
  
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, w, h);

  ctx.fillStyle = '#f0f0f0';
  ctx.fillRect(0, 0, w, h);

  if (!unfoldData.value) return;

  const data = unfoldData.value;
  const vertices2d = data.vertices_2d || [];
  if (vertices2d.length === 0) return;

  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  const pieces = getPieces();

  pieces.forEach(p => {
    const pts = p.outline.points || [];
    if (pts.length > 0) {
      pts.forEach(pt => {
        const x = pt.x;
        const y = pt.y;
        if (x < minX) minX = x;
        if (y < minY) minY = y;
        if (x > maxX) maxX = x;
        if (y > maxY) maxY = y;
      });
    }
  });

  if (minX === Infinity) return;

  const meshW = maxX - minX;
  const meshH = maxY - minY;
  const padding = 40;
  const safeMeshW = (meshW === 0 || !isFinite(meshW)) ? 1 : meshW;
  const safeMeshH = (meshH === 0 || !isFinite(meshH)) ? 1 : meshH;
  
  const baseScale = Math.min((w - padding * 2) / safeMeshW, (h - padding * 2) / safeMeshH);
  const totalScale = baseScale * view2D.value.scale * 3;

  const toScreen = (x, y) => ({
    x: (x - minX) * totalScale + view2D.value.offsetX + padding,
    y: (y - minY) * totalScale + view2D.value.offsetY + padding
  });

  const cutWidth = Math.max(0.5, Math.min(3, 2 / Math.max(0.1, view2D.value.scale)));
  const foldWidth = Math.max(0.5, Math.min(2, 1.5 / Math.max(0.1, view2D.value.scale)));

  pieces.forEach(piece => {
    const pts = piece.outline.points || [];
    if (pts.length < 3) return;
    
    ctx.beginPath();
    const sp0 = toScreen(pts[0].x, pts[0].y);
    ctx.moveTo(sp0.x, sp0.y);
    for (let i = 1; i < pts.length; i++) {
      const sp = toScreen(pts[i].x, pts[i].y);
      ctx.lineTo(sp.x, sp.y);
    }
    ctx.closePath();
    
    ctx.fillStyle = '#ffffff';
    ctx.fill();
    
    ctx.setLineDash([]);
    ctx.strokeStyle = '#000000';
    ctx.lineWidth = cutWidth;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.stroke();
  });

  pieces.forEach(piece => {
    const folds = piece.folds || [];
    folds.forEach(fold => {
      let p1, p2;
      if (fold.a !== undefined && fold.b !== undefined && vertices2d.length > 0) {
        p1 = vertices2d[fold.a];
        p2 = vertices2d[fold.b];
      } else if (fold.start && fold.end) {
        p1 = [fold.start.x, fold.start.y];
        p2 = [fold.end.x, fold.end.y];
      } else { return; }

      const sp1 = toScreen(p1[0], p1[1]);
      const sp2 = toScreen(p2[0], p2[1]);

      ctx.beginPath();
      ctx.moveTo(sp1.x, sp1.y);
      ctx.lineTo(sp2.x, sp2.y);
      
      const kind = fold.kind || fold.fold_type || 'mountain';
      if (kind === 'mountain' || kind === 'Mountain') {
        ctx.strokeStyle = '#ff0000';
        ctx.setLineDash([10, 5]);
      } else if (kind === 'valley' || kind === 'Valley') {
        ctx.strokeStyle = '#0000ff';
        ctx.setLineDash([3, 3]);
      } else {
        ctx.strokeStyle = '#00ff00';
        ctx.setLineDash([]);
      }
      ctx.lineWidth = foldWidth;
      ctx.stroke();
    });
  });
  ctx.setLineDash([]);
};

const loadObj = async () => {
  try {
    const filePath = await open({
      multiple: false,
      filters: [{ name: '3D Models', extensions: ['obj'] }]
    });
    if (!filePath) return;
    const data = await readTextFile(filePath);
    currentObjData.value = data;
    objData.value = data;
    logMessages.value.push(`Файл загружен. Длина: ${data.length} символов`);
  } catch (e) {
    logMessages.value.push(`Ошибка загрузки: ${e}`);
  }
};

const doUnfold = async () => {
  if (!currentObjData.value) return;
  cachedDataRef = null; 
  view2D.value.scale = 1; 
  view2D.value.offsetX = 0; 
  view2D.value.offsetY = 0;
  
  isUnfolding.value = true;
  try {
    const res = await invoke('unfold_mesh', { objData: currentObjData.value, config: { algorithm: 'papercraft' } });
    unfoldData.value = res;
    rustResult.value = JSON.stringify(res).substring(0, 200);
    draw2D();
    logMessages.value.push('Развёртка выполнена');
  } catch (e) {
    logMessages.value.push(`Ошибка Rust: ${e}`);
  } finally {
    isUnfolding.value = false;
  }
};

const handleWheel = (e) => {
  e.preventDefault();
  const delta = e.deltaY < 0 ? 1.1 : 0.9;
  view2D.value.scale = Math.max(0.1, Math.min(50, view2D.value.scale * delta));
  draw2D();
};

const handleMouseDown = (e) => {
  isDragging = true;
  lastX = e.clientX;
  lastY = e.clientY;
};

const handleMouseMove = (e) => {
  if (!isDragging) return;
  view2D.value.offsetX += e.clientX - lastX;
  view2D.value.offsetY += e.clientY - lastY;
  lastX = e.clientX;
  lastY = e.clientY;
  draw2D();
};

const handleMouseUp = () => {
  isDragging = false;
};

onMounted(() => {
  window.addEventListener('wheel', handleWheel, { passive: false });
  draw2D();
});

onUnmounted(() => {
  window.removeEventListener('wheel', handleWheel);
});
</script>

<style scoped>
canvas { display: block; }
</style>




















































