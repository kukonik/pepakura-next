    rustResult.value = '';
  } finally {
    isUnfolding.value = false;
  }
};

// отрисовка 2D
async function draw2D() {
    console.log("[Pepakura Next] Запуск draw2D (Pepakura-стиль)");
    const canvas = this.$refs.canvas2d;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, w, h);

    const data = this.unfoldData;
    if (!data) {
        this.drawFallbackError(ctx, w, h);
        return;
    }

    // НОВЫЙ ФОРМАТ: UnwrapResult (pieces)
    if (data.pieces && data.pieces.length > 0) {
        this.drawPepakuraStyle(ctx, data);
        return;
    }

    // Fallback: СТАРЫЙ ФОРМАТ (vertices_2d + faces) - рисуем только контуры без мозаики
    if (data.vertices_2d && data.faces) {
        this.drawLegacyWireframe(ctx, data);
        return;
    }

    this.drawFallbackError(ctx, w, h);
},

drawPepakuraStyle(ctx, data) {
    ctx.save();
    ctx.translate(10, 10); // отступ листа

    data.pieces.forEach(piece => {
        // 1. Клапаны (рисуем первыми, под контурами)
        if (piece.tabs) {
            ctx.fillStyle = '#e0e0e0';
            ctx.strokeStyle = '#aaaaaa';
