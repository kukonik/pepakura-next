                ctx.moveTo(tab.polygon.points[0].x, tab.polygon.points[0].y);
                for (let i=1; i<tab.polygon.points.length; i++) {
                    ctx.lineTo(tab.polygon.points[i].x, tab.polygon.points[i].y);
                }
                ctx.closePath();
                ctx.fill();
                ctx.stroke();
            });
        }

        // 2. Контур детали (Cut line) - толстая сплошная черная
        if (piece.outline && piece.outline.points) {
            ctx.strokeStyle = '#000000';
            ctx.lineWidth = 2.0;
            ctx.setLineDash([]);
            ctx.beginPath();
            ctx.moveTo(piece.outline.points[0].x, piece.outline.points[0].y);
            for (let i=1; i<piece.outline.points.length; i++) {
                ctx.lineTo(piece.outline.points[i].x, piece.outline.points[i].y);
            }
            ctx.closePath();
            ctx.stroke();
        }

        // 3. Линии сгиба (Folds)
        if (piece.folds) {
            piece.folds.forEach(fold => {
                ctx.beginPath();
                ctx.moveTo(fold.start.x, fold.start.y);
                ctx.lineTo(fold.end.x, fold.end.y);
                ctx.lineWidth = 1.0;

                if (fold.fold_type === 'Mountain') {
                    ctx.strokeStyle = '#cc0000'; // Красный
                    ctx.setLineDash([8, 4, 2, 4]); // Длинный-короткий (стандарт Pepakura)
                } else if (fold.fold_type === 'Valley') {
                    ctx.strokeStyle = '#0000cc'; // Синий
                    ctx.setLineDash([4, 4]); // Короткий пунктир
                } else {
                    ctx.strokeStyle = '#888888'; // Серый нейтральный
                    ctx.setLineDash([2, 2]);
                }
                ctx.stroke();
            });
        }
    });
    ctx.setLineDash([]); // сброс
    ctx.restore();
},

drawLegacyWireframe(ctx, data) {
    // Временный fallback для старого бэкенда, чтобы не было "мозаики"
    ctx.strokeStyle = '#000000';
    ctx.lineWidth = 1;
    ctx.setLineDash([]);
    const v = data.vertices_2d;
    const f = data.faces;
    
    f.forEach(face => {
        ctx.beginPath();
        ctx.moveTo(v[face[0]][0], v[face[0]][1]);
        for(let i=1; i<face.length; i++) {
            ctx.lineTo(v[face[i]][0], v[face[i]][1]);
        }
        ctx.closePath();
        ctx.stroke();
    });
},

drawFallbackError(ctx, w, h) {
    ctx.strokeStyle = 'red';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(w, h); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w, 0); ctx.lineTo(0, h); ctx.stroke();
}

// AI orchestrator — как у тебя
const callOrchestrator = async () => {
  if (!objData.value) return;
  isAiThinking.value = true;
  aiError.value = '';
  aiResult.value = 'Запрос к AI Orchestrator (localhost:3000/api/analyze)...';

  try {
    const meshStats =
      'Vertices: ' + lastMetrics.vertex_count +
      ', Faces: ' + lastMetrics.face_count +
      ', Islands: ' + lastMetrics.islands +
      ', Area: ' + lastMetrics.total_area;

    const userPrompt =
      'Analyze this papercraft unfolding. Why does it have ' +
      lastMetrics.islands +
      ' islands? How to optimize for paper crafting?';

    const response = await fetch('http://127.0.0.1:3000/api/analyze', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mesh_stats: meshStats, user_prompt: userPrompt })
    });

    if (!response.ok) throw new Error('HTTP error! status: ' + response.status);
    const data = await response.json();

    if (data.ai_advice) {
      aiResult.value = data.ai_advice;
    } else if (data.error) {
      aiError.value = data.error;
    } else {
      aiResult.value = JSON.stringify(data, null, 2);
    }
  } catch (e: any) {
    aiError.value =
      'Ошибка подключения:\n' +
      e.toString() +
      '\n\nУбедитесь, что запущен AI Orchestrator.';
    aiResult.value = '';
  } finally {
    isAiThinking.value = false;
  }
};

// экспорт PDF — как у тебя
const handleExport = async () => {
  try {
    console.log('[Export] vertices2D length:', vertices2D.length, 'faces2D length:', faces2D.length);
    if (vertices2D.length === 0 || faces2D.length === 0) {
      alert('Нет данных развёртки для экспорта.');
      return;
    }

    const filePath = await save({
      filters: [{ name: 'PDF', extensions: ['pdf'] }],
      defaultPath: 'unfold.pdf'
    });
    if (!filePath) return;

    await invoke('export_pdf', {
      vertices: vertices2D,
      faces: faces2D,
      islandIds: islandIds,
      path: filePath
    });

    alert('PDF сохранён: ' + filePath);
  } catch (e) {
    console.error('[Export] invoke error:', e);
    alert('Ошибка экспорта: ' + e);
  }
};
