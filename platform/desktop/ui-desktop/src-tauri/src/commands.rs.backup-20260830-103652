use serde::{Deserialize, Serialize};
use tauri::command;
use std::collections::{HashMap, HashSet, BTreeMap};
use pepakura_core::sanitize::SanitizeOptions;
use pepakura_core::unwrap_types::*;

#[derive(Debug, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct UnfoldConfig { pub algorithm: Option<String>, pub engine: Option<String> }

#[derive(Serialize)]
struct FaceDto { vertices: Vec<usize> }

fn sanitize_obj(text: &str) -> String {
    text.lines().map(|line| {
        if line.starts_with("V ") { format!("v{}", &line[1..]) }
        else if line.starts_with("F ") { format!("f{}", &line[1..]) }
        else { line.to_string() }
    }).collect::<Vec<String>>().join("\n")
}

#[command]
pub async fn unfold_mesh(obj_data: String, config: Option<UnfoldConfig>) -> Result<UnwrapResult, String> {
    // --- ВЫЗОВ АДАПТЕРА PAPERCRAFT ---
    if let Some(cfg) = &config {
        if cfg.algorithm.as_deref() == Some("papercraft") {
            return pepakura_core::papercraft_adapter::unfold_with_papercraft(&obj_data);
        }
    }
    // ---------------------------------

    let handle = tokio::task::spawn_blocking(move || {
        let san = sanitize_obj(&obj_data);
        let raw = pepakura_core::import::parse_obj_str(&san).map_err(|e| format!("{:?}", e))?;
        let mesh = pepakura_core::sanitize::simplify_mesh(&raw, &SanitizeOptions::default()).unwrap_or(raw);

        // 1. Разрезание на островки по углу (Dihedral Angle Cut)
        let mut uf = UnionFind::new(mesh.faces.len());
        let mut edge_map: HashMap<(usize, usize), Vec<usize>> = HashMap::new();
        for (fi, f) in mesh.faces.iter().enumerate() {
            if f.vertices.len() < 3 { continue; }
            for i in 0..3 {
                let a = f.vertices[i];
                let b = f.vertices[(i + 1) % 3];
                let key = if a < b { (a, b) } else { (b, a) };
                edge_map.entry(key).or_default().push(fi);
            }
        }

        let n = |vi: usize| [mesh.vertices[vi].x as f64, mesh.vertices[vi].y as f64, mesh.vertices[vi].z as f64];
        let sub = |a: [f64; 3], b: [f64; 3]| [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
        let cross = |a: [f64; 3], b: [f64; 3]| [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
        let norm = |v: [f64; 3]| { let l = (v[0]*v[0]+v[1]*v[1]+v[2]*v[2]).sqrt(); if l > 1e-6 { [v[0]/l, v[1]/l, v[2]/l] } else { [0.0; 3] } };

        for (key, faces) in &edge_map {
            if faces.len() == 2 {
                let f1 = &mesh.faces[faces[0]];
                let f2 = &mesh.faces[faces[1]];
                
                let fn1 = norm(cross(sub(n(f1.vertices[1]), n(f1.vertices[0])), sub(n(f1.vertices[2]), n(f1.vertices[0]))));
                let fn2 = norm(cross(sub(n(f2.vertices[1]), n(f2.vertices[0])), sub(n(f2.vertices[2]), n(f2.vertices[0]))));
                let dot = fn1[0]*fn2[0] + fn1[1]*fn2[1] + fn1[2]*fn2[2];
                let ang = dot.clamp(-1.0, 1.0).acos() * (180.0 / std::f64::consts::PI);
                
                // Если угол больше 40 градусов, НЕ объединяем (разрезаем)
                if ang < 40.0 {
                    uf.union(faces[0], faces[1]);
                }
            }
        }

        let mut comps: BTreeMap<usize, Vec<usize>> = BTreeMap::new();
        for (fi, _) in mesh.faces.iter().enumerate() {
            let r = uf.find(fi);
            comps.entry(r).or_insert_with(Vec::new).push(fi);
        }

        let mut av = vec![[0.0f64; 2]; mesh.vertices.len()];
        let mut piece_ids = vec![0; mesh.vertices.len()];
        let mut current_id = 1;

        // 2. Развёртка каждого островка отдельно
        for (_, fis) in comps.values().enumerate() {
            if fis.is_empty() { continue; }
            
            let mut sv = Vec::new();
            let mut iv = Vec::new();
            let mut vm = HashMap::new();
            let mut sf = Vec::new();
            
            for &fi in fis {
                let of = &mesh.faces[fi];
                let mut nf = pepakura_core::geometry::Face { vertices: vec![0, 0, 0], material_id: of.material_id.clone() };
                for i in 0..3 {
                    let oi = of.vertices[i];
                    let si = *vm.entry(oi).or_insert_with(|| { let i = sv.len(); sv.push(mesh.vertices[oi].clone()); iv.push(oi); i });
                    nf.vertices[i] = si;
                }
                sf.push(nf);
            }
            
            let sm = pepakura_core::geometry::Mesh { vertices: sv, faces: sf, name: "island".to_string(), metadata: Default::default() };
            let cc = pepakura_core::unfold::UnfoldConfig::default();
            let unfolded = pepakura_core::unfold::unfold_mst(&sm, &cc).map_err(|e| e.to_string())?;
            
            // Присваиваем ID островка всем вершинам этого куска
            let id = current_id;
            current_id += 1;
            
            let cols = 5;
            let row = (id - 1) / cols;
            let col = (id - 1) % cols;
            let offset_x = col as f64 * 2.0;
            let offset_y = -row as f64 * 2.0;
            
            for (si, &oi) in iv.iter().enumerate() {
                av[oi] = [unfolded.vertices_2d[si][0] as f64 + offset_x, unfolded.vertices_2d[si][1] as f64 + offset_y];
                piece_ids[oi] = id;
            }
        }

        let fd: Vec<FaceDto> = mesh.faces.iter().map(|f| FaceDto { vertices: f.vertices.clone() }).collect();

        // 3. Сборка контуров и сгибов (как было раньше)
        let mut pieces = Vec::new();
        let mut iem: HashMap<usize, HashSet<(usize, usize)>> = HashMap::new();
        for f in &fd {
            let id = piece_ids[f.vertices[0]];
            let e = iem.entry(id).or_default();
            for i in 0..f.vertices.len() {
                let a = f.vertices[i];
                let b = f.vertices[(i + 1) % f.vertices.len()];
                let k = if a < b { (a, b) } else { (b, a) };
                if !e.insert(k) { e.remove(&k); }
            }
        }

        for (id, be) in &iem {
            if be.is_empty() { continue; }
            let mut ie: HashSet<(usize, usize)> = HashSet::new();
            for f in &fd {
                if piece_ids[f.vertices[0]] != *id { continue; }
                for i in 0..f.vertices.len() {
                    let a = f.vertices[i];
                    let b = f.vertices[(i + 1) % f.vertices.len()];
                    let k = if a < b { (a, b) } else { (b, a) };
                    if be.contains(&k) { continue; }
                    if !ie.insert(k) { ie.remove(&k); }
                }
            }

            let mut folds = Vec::new();
            for (a, b) in &ie {
                let mut adj = Vec::new();
                for f in &mesh.faces {
                    if (f.vertices[0] == *a || f.vertices[1] == *a || f.vertices[2] == *a) &&
                       (f.vertices[0] == *b || f.vertices[1] == *b || f.vertices[2] == *b) {
                        adj.push(f);
                    }
                    if adj.len() == 2 { break; }
                }
                if adj.len() == 2 {
                    let f1 = adj[0];
                    let f2 = adj[1];
                    let n = |vi: usize| [mesh.vertices[vi].x as f64, mesh.vertices[vi].y as f64, mesh.vertices[vi].z as f64];
                    let a1 = n(f1.vertices[0]); let b1 = n(f1.vertices[1]); let c1 = n(f1.vertices[2]);
                    let a2 = n(f2.vertices[0]); let b2 = n(f2.vertices[1]); let c2 = n(f2.vertices[2]);
                    let sub = |a: [f64; 3], b: [f64; 3]| [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
                    let cross = |a: [f64; 3], b: [f64; 3]| [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
                    let norm = |v: [f64; 3]| { let l = (v[0] * v[0] + v[1] * v[1] + v[2] * v[2]).sqrt(); if l > 1e-6 { [v[0] / l, v[1] / l, v[2] / l] } else { [0.0; 3] } };
                    let fn1 = norm(cross(sub(b1, a1), sub(c1, a1)));
                    let fn2 = norm(cross(sub(b2, a2), sub(c2, a2)));
                    let dot = fn1[0] * fn2[0] + fn1[1] * fn2[1] + fn1[2] * fn2[2];
                    let ang = dot.clamp(-1.0, 1.0).acos() * (180.0 / std::f64::consts::PI);
                    if ang > 5.0 {
                        folds.push(FoldLine {
                            start: Point2D { x: av[*a][0] as f32, y: av[*a][1] as f32 },
                            end: Point2D { x: av[*b][0] as f32, y: av[*b][1] as f32 },
                            fold_type: if ang > 90.0 { FoldType::Mountain } else { FoldType::Valley },
                            angle: ang as f32,
                        });
                    }
                }
            }

            let mut ol = Vec::new();
            let mut rm: Vec<(usize, usize)> = be.iter().cloned().collect();
            if let Some(fe) = rm.pop() {
                ol.push(Point2D { x: av[fe.0][0] as f32, y: av[fe.0][1] as f32 });
                ol.push(Point2D { x: av[fe.1][0] as f32, y: av[fe.1][1] as f32 });
                let mut last = fe.1;
                while !rm.is_empty() {
                    if let Some(p) = rm.iter().position(|&(a, b)| a == last || b == last) {
                        let (a, b) = rm.remove(p);
                        let n = if a == last { b } else { a };
                        ol.push(Point2D { x: av[n][0] as f32, y: av[n][1] as f32 });
                        last = n;
                    } else {
                        break;
                    }
                }
            }
            if ol.len() > 1 {
                let f = &ol[0];
                let l = ol.last().unwrap();
                if (f.x - l.x).abs() < 0.01 && (f.y - l.y).abs() < 0.01 {
                    ol.pop();
                }
            }

            let mut ar = 0.0_f32;
            let mut pe = 0.0_f32;
            let n = ol.len();
            if n > 2 {
                for i in 0..n {
                    let j = (i + 1) % n;
                    let dx = ol[j].x - ol[i].x;
                    let dy = ol[j].y - ol[i].y;
                    ar += ol[i].x * ol[j].y - ol[j].x * ol[i].y;
                    pe += (dx * dx + dy * dy).sqrt();
                }
                ar = ar.abs() * 0.5;
            }

            pieces.push(Piece {
                id: *id as u32,
                name: format!("I_{}", id),
                label: Some(String::new()),
                page_number: 0,
                outline: Polygon { points: ol, holes: vec![] },
                folds,
                tabs: vec![],
                area: ar,
                perimeter: pe,
            });
        }

        Ok::<UnwrapResult, String>(UnwrapResult {
            engine_used: "Native".to_string(),
            pieces,
            pages: vec![Page { page_number: 0, piece_ids: vec![], utilization_percent: 0.0 }],
            metrics: UnwrapMetrics { total_pieces: 0, total_pages: 1, total_folds: 0, total_tabs: 0, complexity_score: 0.0 },
            sheet_width: 0.0,
            sheet_height: 0.0,
            margin: 0.0,
            total_area: 0.0,
            total_perimeter: 0.0,
            vertices_2d: av.iter().map(|v| [v[0], v[1]]).collect(),
            faces: fd.iter().map(|f| f.vertices.clone()).collect(),
        })
    });

    match handle.await {
        Ok(Ok(r)) => Ok(r),
        Ok(Err(e)) => Err(e),
        Err(e) => Err(e.to_string()),
    }
}

struct UnionFind { parent: Vec<usize> }
impl UnionFind {
    fn new(size: usize) -> Self { UnionFind { parent: (0..size).collect() } }
    fn find(&mut self, mut i: usize) -> usize {
        let mut root = i; while self.parent[root] != root { root = self.parent[root]; }
        while self.parent[i] != root { let next = self.parent[i]; self.parent[i] = root; i = next; } root
    }
    fn union(&mut self, i: usize, j: usize) {
        let ri = self.find(i); let rj = self.find(j); if ri != rj { self.parent[ri] = rj; }
    }
}

