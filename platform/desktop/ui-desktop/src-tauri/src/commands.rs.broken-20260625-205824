// -- Модифицированная unfold_mesh --
#[tauri::command]
async fn unfold_mesh(
    state: tauri::State<'_, AppState>,
    mesh_path: String,
    options: UnwrapOptions,
) -> Result<UnwrapResult, String> {
    // Загрузка меша (существующая логика)
    let mesh = pepakura_core::io::load_obj(&mesh_path)
        .map_err(|e| format!("Load error: {}", e))?;

    // Существующий алгоритм развёртки (MST + постпроцессинг)
    let (vertices_2d, faces, island_ids, total_sheets, sheet_w, sheet_h) =
        perform_unfold_and_pack(&mesh, &options)?;

    // ---------- НОВОЕ: собираем UnwrapResult ----------
    let mut pieces = Vec::new();
    let num_islands = island_ids.iter().max().map_or(0, |&id| id + 1);
    for iid in 0..num_islands {
        // Индексы граней этого острова
        let face_indices: Vec<usize> = island_ids.iter()
            .enumerate()
            .filter(|(_, &id)| id == iid)
            .map(|(i, _)| i)
            .collect();

        if face_indices.is_empty() { continue; }

        // Собираем все рёбра (неупорядоченные) как пары вершин
        let mut edge_set: std::collections::HashSet<(usize, usize)> = std::collections::HashSet::new();
        for &fi in &face_indices {
            let f = &faces[fi];
            for j in 0..f.len() {
                let a = f[j];
                let b = f[(j + 1) % f.len()];
                let key = if a < b { (a, b) } else { (b, a) };
                if edge_set.contains(&key) {
                    edge_set.remove(&key); // ребро внутреннее
                } else {
                    edge_set.insert(key);
                }
            }
        }
        // Оставшиеся — контурные рёбра
        if edge_set.is_empty() { continue; }

        // Восстанавливаем замкнутый полигон (простая трассировка)
        let mut outline: Vec<Vec2> = Vec::new();
        let mut remaining: Vec<(usize, usize)> = edge_set.into_iter().collect();
        // Начинаем с первого ребра
        let first = remaining.pop().unwrap();
        outline.push(vertices_2d[first.0].clone());
        outline.push(vertices_2d[first.1].clone());
        while !remaining.is_empty() {
            let last = outline.last().unwrap();
            // Ищем ребро, содержащее последнюю вершину
            if let Some(pos) = remaining.iter().position(|&(a, b)| {
                a == find_vertex_index(last, &vertices_2d) || b == find_vertex_index(last, &vertices_2d)
            }) {
                let (a, b) = remaining.remove(pos);
                let next_idx = if find_vertex_index(last, &vertices_2d) == a { b } else { a };
                outline.push(vertices_2d[next_idx].clone());
            } else {
                break; // не должны сюда попадать, но страховка
            }
        }
        // Убираем последнюю точку, если она равна первой (замкнутость)
        if outline.len() > 1 && (outline[0].x - outline.last().unwrap().x).abs() < 1e-4
                              && (outline[0].y - outline.last().unwrap().y).abs() < 1e-4 {
            outline.pop();
        }

        let area = polygon_area(&outline);
        let perimeter = polygon_perimeter(&outline);

        // Пока клапаны и линии сгиба отсутствуют; позже вы сможете их доработать
        pieces.push(Piece {
            id: iid,
            label: None,
            outline,
            folds: vec![],
            tabs: vec![],
            area,
            perimeter,
        });
    }

    let total_area: f32 = pieces.iter().map(|p| p.area).sum();
    let total_perimeter: f32 = pieces.iter().map(|p| p.perimeter).sum();
    // Простейшая эвристика сложности
    let complexity_score = (pieces.len() as f32) * 10.0 + total_perimeter * 0.1;

    Ok(UnwrapResult {
        pieces,
        sheet_width: sheet_w,
        sheet_height: sheet_h,
        margin: options.margin,
        num_pages: total_sheets as u32,
        total_area,
        total_perimeter,
        complexity_score,
    })
}

// Вспомогательные функции (добавьте их ниже или в тот же файл, можно оставить как есть)
fn find_vertex_index(v: &Vec2, vertices: &[Vec2]) -> usize {
    vertices.iter().position(|p| (p.x - v.x).abs() < 1e-5 && (p.y - v.y).abs() < 1e-5).unwrap()
}
fn polygon_area(poly: &[Vec2]) -> f32 {
    let n = poly.len();
    if n < 3 { return 0.0; }
    let mut area = 0.0;
    for i in 0..n {
        let j = (i + 1) % n;
        area += poly[i].x * poly[j].y;
        area -= poly[j].x * poly[i].y;
    }
    area.abs() * 0.5
}
fn polygon_perimeter(poly: &[Vec2]) -> f32 {
    poly.windows(2).map(|w| dist(&w[0], &w[1])).sum::<f32>()
        + dist(&poly[poly.len()-1], &poly[0])
}
fn dist(a: &Vec2, b: &Vec2) -> f32 {
    ((a.x - b.x).powi(2) + (a.y - b.y).powi(2)).sqrt()
}

