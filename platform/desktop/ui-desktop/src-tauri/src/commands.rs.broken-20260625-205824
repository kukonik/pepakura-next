fn process_and_pack_island(
    all_vertices_2d: &mut Vec<[f64; 2]>,
    _current_x: &mut f64,
    _current_y: &mut f64,
    _row_max_height: &mut f64,
    _padding: f64,
    _max_row_width: f64,
    final_vertices_2d: &[[f64; 2]],
    inv_vertex_map: &[usize],
) {
    for &v_idx in inv_vertex_map {
        if v_idx < final_vertices_2d.len() {
            let v = final_vertices_2d[v_idx];
            all_vertices_2d.push([v[0], v[1]]);
        }
    }
}

