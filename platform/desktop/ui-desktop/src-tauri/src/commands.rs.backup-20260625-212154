}

#[derive(Serialize)]
struct FaceDto { vertices: Vec<usize> }

#[derive(Serialize)]
struct UnfoldResponse {
    success: bool,
    algorithm_used: String,
    message: String,
    vertex_count: usize,
    face_count: usize,
    islands: usize,
    total_area: f64,
    vertices_2d: Vec<[f64; 2]>,
    faces: Vec<FaceDto>,
    island_ids: Vec<usize>,
