{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pepakura Next",
  "version": "0.1.0",
  "identifier": "com.pepakura.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pepakura Next",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}