{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:default",
      "allow": [{ "path": "**/*" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**/*" }]
    },
    {
      "identifier": "fs:read-all",
      "allow": [{ "path": "**/*" }]
    }
  ]
}