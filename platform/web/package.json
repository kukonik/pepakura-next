{
  "name": "pepakura-web",
  "version": "0.3.0",
  "description": "Pepakura Next Web Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build ../../crates/pepakura_wasm --target web --out-dir ../public/wasm",
