  },
  "dependencies": {
    "vue": "^3.4.0",
    "three": "^0.160.0",
    "pinia": "^2.1.0",
    "@pepakura/shared": "file:../../shared"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  }
}